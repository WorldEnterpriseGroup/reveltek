---
import { ClientRouter } from 'astro:transitions';
import Preloader from '../components/chrome/Preloader.astro';
import Header from '../components/chrome/Header.astro';
import HeaderAlt from '../components/chrome/HeaderAlt.astro';
import HeaderOverview from '../components/chrome/HeaderOverview.astro';
import HeaderContact from '../components/chrome/HeaderContact.astro';
import HeaderInner from '../components/chrome/HeaderInner.astro';
import HeaderTwo from '../components/chrome/HeaderTwo.astro';
import HeaderThree from '../components/chrome/HeaderThree.astro';
import Footer from '../components/chrome/Footer.astro';
import FooterInner from '../components/chrome/FooterInner.astro';
import FooterServices from '../components/chrome/FooterServices.astro';
import FooterBlog from '../components/chrome/FooterBlog.astro';
import FooterInsights from '../components/chrome/FooterInsights.astro';
import FooterCompany from '../components/chrome/FooterCompany.astro';
import FooterConsulting from '../components/chrome/FooterConsulting.astro';
import FooterSoftware from '../components/chrome/FooterSoftware.astro';
import FooterTwo from '../components/chrome/FooterTwo.astro';
import FooterGrey from '../components/chrome/FooterGrey.astro';
import MobileNav from '../components/islands/MobileNav.astro';
import Counters from '../components/islands/Counters.astro';
import ClientSlider from '../components/islands/ClientSlider.astro';
import ScrollReveals from '../components/islands/ScrollReveals.astro';

type HeaderKind = 'main' | 'alt' | 'overview' | 'contact' | 'inner' | 'two' | 'three';
type FooterKind =
  | 'main'
  | 'inner'
  | 'services'
  | 'blog'
  | 'insights'
  | 'company'
  | 'consulting'
  | 'software'
  | 'two'
  | 'grey';

const HEADERS: Record<HeaderKind, unknown> = {
  main: Header,
  alt: HeaderAlt,
  overview: HeaderOverview,
  contact: HeaderContact,
  inner: HeaderInner,
  two: HeaderTwo,
  three: HeaderThree,
};
const FOOTERS: Record<FooterKind, unknown> = {
  main: Footer,
  inner: FooterInner,
  services: FooterServices,
  blog: FooterBlog,
  insights: FooterInsights,
  company: FooterCompany,
  consulting: FooterConsulting,
  software: FooterSoftware,
  two: FooterTwo,
  grey: FooterGrey,
};

interface Props {
  /** Verbatim page <title> (e.g. "RevelTek | Business & Technology Consulting"). */
  title: string;
  /** Meta description for the page. */
  description: string;
  /** Canonical path, e.g. "/" (home) or "/services.html". */
  canonicalPath: string;
  /** Chrome variant: default shell, or "three" for the index-3 alternate home. */
  header?: HeaderKind;
  /** Footer variant matching the page's approved legacy footer. */
  footer?: FooterKind;
  /** Absolute OG image URL. */
  ogImage?: string;
  /** Set true to emit a noindex/nofollow robots meta (e.g. 404 page). */
  noindex?: boolean;
  /** Short name for the auto BreadcrumbList trail (defaults to the page title). */
  breadcrumbName?: string;
  /** Extra JSON-LD entity graphs for this page (org + breadcrumbs always emit). */
  jsonLd?: Record<string, unknown>[];
  /** AVIF hero/LCP image to preload (relative to site root). */
  heroPreload?: string;
  /** Extra raw head markup captured from the legacy page (first-party only). */
  extraHead?: string;
}

const {
  title,
  description,
  canonicalPath,
  header = 'main',
  footer = 'main',
  ogImage = 'https://reveltek.com/assets/img/og-cover.avif',
  noindex = false,
  breadcrumbName,
  jsonLd = [],
  heroPreload,
  extraHead = '',
} = Astro.props;

const HeaderTag = HEADERS[header] as typeof Header;
const FooterTag = FOOTERS[footer] as typeof Footer;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'RevelTek Inc.',
  url: 'https://reveltek.com',
  logo: 'https://reveltek.com/assets/img/svg/reveltek.svg',
  description:
    'RevelTek Inc. is a US-based technical consulting firm delivering SaaS solutions, strategic IT consulting, AI, cloud, and product development management.',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Lewes, Delaware, USA',
  },
  naics: ['541511', '541611', '541512'],
};

// Legacy "/index.html" still maps home so older variant canonicals resolve.
const isHome = canonicalPath === '/' || canonicalPath === '/index.html';
const canonical = isHome ? 'https://reveltek.com/' : `https://reveltek.com${canonicalPath}`;

// Breadcrumb trail: Home + this page (names come from the page's own props,
// so no claims are invented). The front page itself is Home — no trail needed.
const brandStripped = title
  .replace(/\s*[—–-]\s*RevelTek.*$/, '')
  .replace(/^RevelTek\s*\|\s*/, '')
  .trim();
const trailName = (breadcrumbName ?? brandStripped) || title;
const breadcrumbSchema =
  isHome
    ? null
    : {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          {
            '@type': 'ListItem',
            position: 1,
            name: 'Home',
            item: 'https://reveltek.com/',
          },
          {
            '@type': 'ListItem',
            position: 2,
            name: trailName,
            item: canonical,
          },
        ],
      };
const extraSchemas = [...(breadcrumbSchema ? [breadcrumbSchema] : []), ...jsonLd];

// OG image MIME derived from the file extension (per-page overrides and
// the default cover are .avif). Width/height declare the standard
// 1200x630 OG canvas scrapers expect; alt falls back to the page title.
const ogImageType = ogImage.endsWith('.png')
  ? 'image/png'
  : ogImage.endsWith('.webp')
    ? 'image/webp'
    : ogImage.endsWith('.jpg') || ogImage.endsWith('.jpeg')
      ? 'image/jpeg'
      : 'image/avif';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta http-equiv="x-ua-compatible" content="ie=edge" />
  <meta name="description" content={description} />
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
  <title>{title}</title>
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content={ogImageType} />
  <meta property="og:image:alt" content={title} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <meta name="theme-color" content="#14212b" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  {extraSchemas.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}
  <!--====== Feeds: site-wide + per-collection RSS (see src/data/feed-items.ts) ======-->
  <link rel="alternate" type="application/rss+xml" title="RevelTek — Insights (Blog, Events & Guides)" href="/feed.xml" />
  <link rel="alternate" type="application/rss+xml" title="RevelTek — Blog & Insights" href="/blog-feed.xml" />
  <link rel="alternate" type="application/rss+xml" title="RevelTek — Events & Webinars" href="/events-feed.xml" />
  <link rel="alternate" type="application/rss+xml" title="RevelTek — Guides & Reports" href="/guides-feed.xml" />
  <!--====== PWA: installable shell, no visual change ======-->
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <!--====== Favicon Icon ======-->
  <link rel="icon" href="/assets/img/svg/swirl_white.svg" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/icons/favicon-32.png" />
  <!--====== Fonts: preconnect + swap (same families as theme CSS @import) ======-->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@300;400;500;600;700&family=Source+Sans+Pro:wght@600;700&display=swap"
    rel="stylesheet"
  />
  {heroPreload && (
    <link rel="preload" as="image" href={heroPreload} type="image/avif" fetchpriority="high" />
  )}
  <!--====== Critical CSS (above-fold theme) ======-->
  <link rel="stylesheet" href="assets/css/bootstrap.min.css" />
  <link rel="stylesheet" href="assets/css/font-awesome.min.css" />
  <link rel="stylesheet" href="assets/css/flaticon.css" />
  <link rel="stylesheet" href="assets/css/style.css" />
  <!--====== Deferred CSS (below-fold widgets only) ======-->
  <link rel="stylesheet" href="assets/css/animate.min.css" media="print" onload="this.media='all'" />
  <link rel="stylesheet" href="assets/css/magnific-popup.css" media="print" onload="this.media='all'" />
  <link rel="stylesheet" href="assets/css/slick.css" media="print" onload="this.media='all'" />
  <link rel="stylesheet" href="assets/css/jquery-ui.min.css" media="print" onload="this.media='all'" />
  <noscript>
    <link rel="stylesheet" href="assets/css/animate.min.css" />
    <link rel="stylesheet" href="assets/css/magnific-popup.css" />
    <link rel="stylesheet" href="assets/css/slick.css" />
    <link rel="stylesheet" href="assets/css/jquery-ui.min.css" />
  </noscript>
  <script type="speculationrules">
    {"prerender": [{"where": {"href_matches": "/*"}, "eagerness": "moderate"}]}
  </script>
  <!-- View Transitions: SPA-feel client navigation for the 47-page content
       site. Fallback-safe (fallback="animate"; same-origin GET only, forms
       degrade to full loads, reduced-motion respected). The router ships one
       inline module script (deferred by definition — never render-blocking)
       and dedupes external scripts by src across swaps, so legacy deferred
       bundles never double-initialize. -->
  <ClientRouter fallback="animate" />
  <!--====== Deferred core: jQuery must execute before any per-page plugin
       below (defer preserves document order). modernizr sits in <head> per
       its own recommendation (html classes before first paint). Everything
       else deferred stays at body end. ======-->
  <script defer src="assets/js/vendor/modernizr-3.6.0.min.js"></script>
  <script defer src="assets/js/vendor/jquery-3.6.0.min.js"></script>
  <!--====== Per-page diet (W-B): pages that need a heavy jQuery plugin pass
       it via extraHead so it executes right here — after jQuery, before the
       body-end bundles. Audit (grep .astro for the trigger selectors):
       - isotope.pkgd.min.js → portfolio, portfolio-2 (.project-isotope),
         index-3 (#factIsotpe)
       - jquery.magnific-popup.min.js → product-details (.img-popup; no page
         currently uses .popup-video)
       - jquery-ui.min.js → shop (#slider-range; no .datepicker anywhere)
       main.js guards every call site (typeof $.fn.* check), so pages that
       don't ship a plugin skip it instead of throwing. ======-->
  <Fragment set:html={extraHead} />
</head>

<body>
  <a href="#main" class="skip-link">Skip to content</a>
  <Preloader />
  <HeaderTag currentPath={canonicalPath} />
  <main id="main" transition:animate="fade">
    <slot />
  </main>
  <FooterTag />
  <!-- Zero-dependency vanilla islands: run without jQuery/slick, start work
       only when needed (IntersectionObserver-gated), re-wire on every View
       Transition via astro:page-load. Static fallbacks are plain markup:
       server-rendered nav (desktop submenus are CSS :hover), final counter
       numbers, and the unwrapped logo grid. -->
  <MobileNav />
  <Counters />
  <ClientSlider />
  <ScrollReveals />
  <!--====== Deferred scripts: execution order preserved, parser never blocked ======-->
  <!-- Legacy inventory (all defer; zero render-blocking):
       REPLACED by islands above (kept loaded, but their passes early-return
       via [data-island] markers in main.js): mobile nav/offcanvas/sticky/
       back-to-top (MobileNav island), fact counters (Counters island),
       #clientSlider logo carousel (ClientSlider island), .wow scroll
       reveals (ScrollReveals island — wow.min.js no longer loaded;
       animate.min.css stays: pure-CSS keyframes the island reuses).
       DROPPED: jquery.countTo.js (dead — zero invocations; plugin files
       removed) and wow.min.js (replaced by the ScrollReveals island).
       PER-PAGE via extraHead (in <head>, after jQuery — see above):
       - isotope.pkgd.min.js → portfolio, portfolio-2, index-3
       - jquery.magnific-popup.min.js → product-details
       - jquery-ui.min.js → shop
       KEPT deferred globally — no regression-free vanilla replacement yet:
       - bootstrap + popper: accordion/collapse + dropdown positioning
       - slick: banner/team/testimonial/latest-post/product sliders
         (cloned infinite slides, dots/arrows, data-thumb paging)
       - inview/easypiechart: scroll pie charts + skill progress bars
       - main.js: remaining widget initializations (idempotent; re-invoked
         on every View Transition via window.RevelWidgets.init from the
         MobileNav island; preloader uses transition:persist instead.
         Plugin call sites are guarded, so absent per-page plugins no-op.)
       NOTE: rtl-main.js removed (W-2 dead weight — 16KB, zero references in
       src/public): legacy RTL Version/*.html copies referenced
       ../assets/js/rtl-main.js, which never resolved in the built site
       (RTL Version/ is not part of the Astro build). -->
  <script defer src="assets/js/bootstrap.min.js"></script>
  <script defer src="assets/js/popper.min.js"></script>
  <script defer src="assets/js/slick.min.js"></script>
  <script defer src="assets/js/jquery.inview.min.js"></script>
  <script defer src="assets/js/jquery.easypiechart.min.js"></script>
  <script defer src="assets/js/main.js"></script>
  <!--====== PWA: offline support registration (progressive enhancement) ======-->
  <script defer src="assets/js/sw-register.js"></script>
</body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: auto;
  }
  .skip-link:focus {
    left: 1rem;
    top: 1rem;
    z-index: 9999;
    background: #ff4a17;
    color: #14212b;
    font-weight: 700;
    padding: 0.5rem 1rem;
  }
  /* Theme reset uses `a:focus { outline: none }` (0,1,1), which beats a bare
     `:focus-visible` (0,1,0). Scope to body so keyboard focus always wins
     regardless of stylesheet order. Token unchanged (#ff4a17 >= 3:1 on both
     light and dark surfaces for the 3px indicator). */
  body a:focus-visible,
  body button:focus-visible,
  body input:focus-visible,
  body textarea:focus-visible,
  body select:focus-visible,
  body [tabindex]:focus-visible {
    outline: 3px solid #ff4a17;
    outline-offset: 2px;
  }
  /* Additive mega-panel divider inside the Services submenu (theme tokens). */
  .menu-items .submenu li.submenu-featured > a {
    border-top: 1px solid #f5f5f5;
  }
</style>
