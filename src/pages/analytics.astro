---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="RevelTek | Analytics"
  description="RevelTek provides data and analytics solutions including BI dashboards, big data processing, and predictive analytics."
  canonicalPath="/analytics.html"
  header="alt"
  footer="services"
>
<!--====== Breadcrumb part Start ======-->
    <section class="breadcrumb-section bg-img-c" style="background-image: url(assets/img/breadcrumb.avif);">
        <div class="container">
            <div class="breadcrumb-text">
                <!-- Updated Title -->
                <h1 class="page-title">Analytics</h1>
                <ul>
                    <!-- Updated Breadcrumb Path (No Home) -->
                    <li>Services</li>
                    <li>Analytics</li>
                </ul>
            </div>
        </div>
        <div class="breadcrumb-shapes">
            <div class="one"></div>
            <div class="two"></div>
            <div class="three"></div>
        </div>
    </section>
    <!--====== Breadcrumb part End ======-->

    <!--====== Service Details Start ======-->
    <section class="service-details section-gap">
        <div class="container">
            <div class="row">
                <!-- Dettails Content -->
                <div class="col-lg-8">
                    <div class="service-details-content">
                        <div class="main-thumb mb-40">
                             <!-- Updated Alt Text -->
                            <img fetchpriority="high" decoding="async" width="770" height="515" src="assets/img/details/service-01.avif" alt="Data Analytics Dashboard Example">
                        </div>
                        <!-- Updated Title -->
                        <h2 class="title">Data & Analytics Solutions</h2>
                        <!-- Updated Content -->
                        <p>
                            Transform your raw data into actionable insights with RevelTek's analytics services. We help you make sense of complex information through business intelligence (BI) dashboards, big data processing, and predictive modeling. Our team guides you in collecting, analyzing, and visualizing data to drive smarter decisions, optimize operations, and uncover growth paths hidden within your datasets.
                        </p>
                        <ul class="circle-check-list mt-50 mb-50">
                            <!-- Updated List Items -->
                            <li>
                                <i class="fas fa-check"></i>{' '}Gain clear visibility into key business metrics with interactive BI dashboards.
                            </li>
                            <li>
                                <i class="fas fa-check"></i>{' '}Process and analyze large volumes of data effectively using big data tools.
                            </li>
                            <li>
                                <i class="fas fa-check"></i>{' '}Use predictive analytics to forecast trends and inform strategic planning efforts.
                            </li>
                        </ul>
                        <div class="row align-items-center justify-content-center">
                            <div class="col-lg-6">
                                <div class="image text-center mb-40">
                                     <!-- Updated Alt Text -->
                                    <img loading="lazy" decoding="async" width="370" height="350" src="assets/img/details/service-02.avif" alt="Analytics Process Flowchart">
                                </div>
                            </div>
                            <div class="col-lg-6">
                                 <!-- Updated Sub-Title -->
                                <h3 class="sub-title">Our Analytics Method</h3>
                                <!-- Updated Content -->
                                <p>
                                    We start by understanding your business questions. Then we identify relevant data sources, build robust data pipelines, apply analytical models, and create clear visualizations for insights.
                                </p>
                                <ul class="check-list mt-30 mb-40">
                                    <!-- Updated List Items -->
                                    <li><i class="fas fa-check"></i>BI & Dashboard Creation</li>
                                    <li><i class="fas fa-check"></i>Big Data Engineering</li>
                                    <li><i class="fas fa-check"></i>Predictive Model Building</li>
                                    <li><i class="fas fa-check"></i>Data Strategy & Governance</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="faq-section mt-40">
                        <!-- FAQ LOOP - Updated Questions/Answers for Analytics -->
                        <div class="accordion faq-loop border-style" id="faqAccordion">
                            <div class="card">
                                <div class="card-header">
                                    <h6 class="collapsed" data-toggle="collapse" data-target="#collapseOne">
                                        What tools do you use for analytics?
                                        <span class="icons">
                                            <i class="far fa-plus"></i>
                                        </span>
                                    </h6>
                                </div>
                                <div id="collapseOne" class="collapse" data-parent="#faqAccordion">
                                    <div class="card-body">
                                        We leverage a range of modern tools based on project needs, including platforms like Power BI, Tableau, and various cloud data services (AWS, Azure, GCP).
                                    </div>
                                </div>
                            </div>
                            <div class="card">
                                <div class="card-header active-header">
                                    <h6 class="collapsed" data-toggle="collapse" data-target="#collapseTwo">
                                        How can analytics help our specific industry?
                                        <span class="icons">
                                            <i class="far fa-minus"></i>
                                        </span>
                                    </h6>
                                </div>
                                <div id="collapseTwo" class="collapse show" data-parent="#faqAccordion">
                                    <div class="card-body">
                                        We tailor analytics use cases to your sector. Examples include customer behavior analysis in Retail, risk modeling in Fintech, or operational efficiency in Health.
                                    </div>
                                </div>
                            </div>
                            <div class="card">
                                <div class="card-header">
                                    <h6 class="collapsed" data-toggle="collapse" data-target="#collapseThree">
                                        What's the difference between BI and predictive analytics?
                                        <span class="icons">
                                            <i class="far fa-plus"></i>
                                        </span>
                                    </h6>
                                </div>
                                <div id="collapseThree" class="collapse" data-parent="#faqAccordion">
                                    <div class="card-body">
                                        BI typically focuses on describing past and present performance through dashboards. Predictive analytics uses data to forecast future outcomes and trends.
                                    </div>
                                </div>
                            </div>
                            <div class="card">
                                <div class="card-header">
                                    <h6 class="collapsed" data-toggle="collapse" data-target="#collapseFour">
                                        Do we need perfect data to start?
                                        <span class="icons">
                                            <i class="far fa-plus"></i>
                                        </span>
                                    </h6>
                                </div>
                                <div id="collapseFour" class="collapse" data-parent="#faqAccordion">
                                    <div class="card-body">
                                        No. Data cleaning and preparation are often part of the process. We help assess data quality and build strategies to improve it for better insights over time.
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- End Faq LOOP -->
                    </div>
                </div>
                <!-- Sidebar -->
                <div class="col-lg-4 col-md-8">
                    <div class="sidebar">
                        <!-- Services List Widget - UPDATED -->
                        <div class="widget cat-widget">
                            <h4 class="widget-title">Our Services</h4>
                            <ul>
                                <!-- Updated Links & Added 'active' class -->
                                <li><a href="software.html">Software <span><i class="far fa-angle-right"></i></span></a></li>
                                <li><a href="consulting.html">Consulting <span><i class="far fa-angle-right"></i></span></a></li>
                                <li><a href="ai.html">AI <span><i class="far fa-angle-right"></i></span></a></li>
                                <li><a href="products.html">Products <span><i class="far fa-angle-right"></i></span></a></li>
                                <li><a href="cloud.html">Cloud <span><i class="far fa-angle-right"></i></span></a></li>
                                <li class="active"><a href="analytics.html">Analytics <span><i class="far fa-angle-right"></i></span></a></li>
                            </ul>
                        </div>
                        <!-- Contact Widget (Kept as is, typo corrected) -->
                        <div class="widget contact-widget">
                            <h4 class="widget-title">Contact Us</h4>
                            <form action="#">
                                <input type="text" placeholder="Your Email">
                                <textarea placeholder="Message"></textarea>
                                <button type="submit" class="main-btn main-btn-3">Send Message</button>
                            </form>
                        </div>
                        <!-- CTA Widget (Kept as is, link updated) -->
                        <div class="widget cta-widget" style="background-image: url(assets/img/sidebar/cta.avif);">
                            <h4 class="title">Need Data Insights?</h4> <!-- Simple text -->
                            <a href="contact.html" class="main-btn">Send Message</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--====== Service Details End ======-->

    <!--====== CTA Start ======-->
    <section class="cta-aection">
        <div class="container">
            <div class="cta-wrap bg-img-c" style="background-image: url(assets/img/lines/16.avif);">
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <div class="cta-content text-center">
                            <div class="section-title both-border mb-30">
                                <!-- Updated Title Content -->
                                <span class="title-tag">Unlock Data Value</span>
                                <h2 class="title">Ready to Make Data Driven Decisions? Talk to Our Experts!</h2>
                            </div>
                             <!-- Updated Button Link -->
                            <a href="contact.html" class="main-btn main-btn-3">Get Started</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--====== CTA End ======-->

    <!--====== Client Area Start ======-->
    <section class="client-section">
        <div class="container">
            <div class="client-slider section-gap line-top">
                <div class="row align-items-center justify-content-between" id="clientSlider">
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="162" height="90" src="assets/img/clients/01.avif" alt="Client Logo 1">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="193" height="85" src="assets/img/clients/02.avif" alt="Client Logo 2">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="117" height="95" src="assets/img/clients/03.avif" alt="Client Logo 3">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="164" height="93" src="assets/img/clients/04.avif" alt="Client Logo 4">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="104" height="96" src="assets/img/clients/05.avif" alt="Client Logo 5">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="162" height="90" src="assets/img/clients/01.avif" alt="Client Logo 6">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="193" height="85" src="assets/img/clients/02.avif" alt="Client Logo 7">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="117" height="95" src="assets/img/clients/03.avif" alt="Client Logo 8">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="164" height="93" src="assets/img/clients/04.avif" alt="Client Logo 9">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="104" height="96" src="assets/img/clients/05.avif" alt="Client Logo 10">
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--====== Client Area End ======-->
</BaseLayout>
