---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="RevelTek | Guides & Reports"
  description="Download free guides, whitepapers, and reports from RevelTek on IT strategy, AI implementation, cloud adoption, and more tech topics."
  canonicalPath="/guides.html"
  header="alt"
  footer="insights"
  heroPreload="/assets/img/breadcrumb.avif">
<!--====== Breadcrumb part Start ======-->
    <section class="breadcrumb-section bg-img-c" style="background-image: url(assets/img/breadcrumb.avif);">
        <div class="container">
            <div class="breadcrumb-text">
                 <!-- Updated Title -->
                <h1 class="page-title">Guides & Reports</h1>
                <ul>
                     <!-- Updated Path -->
                    <li>Insights</li>
                    <li>Guides</li>
                </ul>
            </div>
        </div>
        <div class="breadcrumb-shapes">
            <div class="one"></div>
            <div class="two"></div>
            <div class="three"></div>
        </div>
    </section>
    <!--====== Breadcrumb part End ======-->

    <!--====== Guides Section Start (Using Service Section Layout) ======-->
<section class="service-section shape-style-one section-gap grey-bg">
	<div class="container">
		<!-- Section Title -->
		<div class="section-title text-center both-border mb-30">
			<span class="title-tag">Downloadable Resources</span> <!-- Updated -->
			<h2 class="title">Explore Our In Depth Guides <br> On Key Tech Topics</h2> <!-- Updated -->
		</div>
		<!-- Guides Boxes -->
		<div class="row service-boxes justify-content-center">
			<!-- Guide 1 Example -->
			<div class="col-lg-4 col-md-6 col-sm-8 col-10 col-tiny-12 wow fadeInLeft" data-wow-duration="1500ms"
				data-wow-delay="400ms">
				<div class="service-box text-center">
					<div class="icon">
						<img loading="eager" fetchpriority="high" decoding="async" width="103" height="100" src="assets/img/icons/01.avif" srcset="assets/img/icons/01.avif 103w" sizes="(max-width: 768px) 100vw, 103px" alt="AI Guide Icon"> <!-- Update Icon -->
					</div>
					<h3><a href="#">AI Strategy Guide</a></h3> <!-- Link to download/landing page -->
					<p>A practical framework for developing and implementing an AI strategy.</p>
					<a href="#" class="service-link"> <!-- Link to download/landing page -->
						Download <i class="fal fa-arrow-to-bottom"></i> <!-- Updated Text/Icon -->
					</a>
				</div>
			</div>
			<!-- Guide 2 Example -->
			<div class="col-lg-4 col-md-6 col-sm-8 col-10 col-tiny-12 wow fadeInUp" data-wow-duration="1500ms"
				data-wow-delay="600ms">
				<div class="service-box text-center">
					<div class="icon">
						<img loading="lazy" decoding="async" width="101" height="101" src="assets/img/icons/02.avif" srcset="assets/img/icons/02.avif 101w" sizes="(max-width: 768px) 100vw, 101px" alt="Cloud Guide Icon"> <!-- Update Icon -->
					</div>
					<h3><a href="#">Cloud Migration Checklist</a></h3>
					<p>Essential steps and considerations for a successful cloud transition.</p>
					<a href="#" class="service-link">
						Download <i class="fal fa-arrow-to-bottom"></i>
					</a>
				</div>
			</div>
			<!-- Guide 3 Example -->
			<div class="col-lg-4 col-md-6 col-sm-8 col-10 col-tiny-12 wow fadeInRight" data-wow-duration="1500ms"
				data-wow-delay="800ms">
				<div class="service-box text-center">
					<div class="icon">
						<img loading="lazy" decoding="async" width="100" height="100" src="assets/img/icons/03.avif" srcset="assets/img/icons/03.avif 100w" sizes="(max-width: 768px) 100vw, 100px" alt="SaaS Guide Icon"> <!-- Update Icon -->
					</div>
					<h3><a href="#">SaaS Development Trends</a></h3>
					<p>Insights into the latest trends shaping modern SaaS application building.</p>
					<a href="#" class="service-link">
						Download <i class="fal fa-arrow-to-bottom"></i>
					</a>
				</div>
			</div>
			<!-- Add more guides as needed -->
		</div>
	</div>
	<div class="dots-line">
		<img loading="lazy" decoding="async" width="494" height="756" src="assets/img/lines/07.avif" srcset="assets/img/lines/07.avif 494w" sizes="(max-width: 768px) 100vw, 494px" alt="Decorative Line">
	</div>
</section>
<!--====== Guides Section End ======-->

    <!--====== Additional Guides Section (Using Feature Box Layout) ======-->
<section class="feature-section section-gap">
	<div class="container">
		<div class="section-title text-center both-border mb-50">
			<span class="title-tag"> More Resources </span>
			<h2 class="title">Whitepapers and Reports <br> For Deeper Insights</h2>
		</div>
		<!-- Feature boxes (Guides) -->
		<div class="feature-boxes row justify-content-center">
                 <!-- Guide 4 Example -->
			<div class="col-lg-4 col-md-6 col-10 col-tiny-12">
				<div class="feature-box">
					<div class="feature-bg bg-img-c" style="background-image: url(assets/img/feature/04.avif);"> <!-- Use relevant image -->
					</div>
					<div class="feature-desc">
						<a href="#" class="feature-link"><i class="fal fa-arrow-to-bottom"></i></a> <!-- Update Icon/Link -->
						<h4>Data Analytics Whitepaper</h4> <!-- Update Text -->
						<p>Leveraging data for growth</p>
					</div>
				</div>
			</div>
                <!-- Guide 5 Example -->
			<div class="col-lg-4 col-md-6 col-10 col-tiny-12">
				<div class="feature-box">
					<div class="feature-bg bg-img-c" style="background-image: url(assets/img/feature/05.avif);"> <!-- Use relevant image -->
					</div>
					<div class="feature-desc">
						<a href="#" class="feature-link"><i class="fal fa-arrow-to-bottom"></i></a>
						<h4>Digital Transformation Report</h4> <!-- Update Text -->
						<p>Key steps for modernizing</p>
					</div>
				</div>
			</div>
                 <!-- Guide 6 Example -->
			<div class="col-lg-4 col-md-6 col-10 col-tiny-12">
				<div class="feature-box">
					<div class="feature-bg bg-img-c" style="background-image: url(assets/img/feature/06.avif);"> <!-- Use relevant image -->
					</div>
					<div class="feature-desc">
						<a href="#" class="feature-link"><i class="fal fa-arrow-to-bottom"></i></a>
						<h4>Product Management Guide</h4> <!-- Update Text -->
						<p>Building successful digital items</p>
					</div>
				</div>
			</div>
                <!-- Add more guides here -->
		</div>
	</div>
</section>
<!--====== Additional Guides Section End ======-->

<!--====== CTA Start ======-->
<section class="cta-aection section-gap grey-bg"> <!-- Added grey-bg -->
	<div class="container">
		<div class="cta-wrap bg-img-c" style="background-image: url(assets/img/lines/16.avif);">
			<div class="row justify-content-center">
				<div class="col-lg-8">
					<div class="cta-content text-center">
						<div class="section-title both-border mb-30">
							<span class="title-tag">Stay Informed</span> <!-- Updated -->
							<h2 class="title">Get Our Latest Guides and Insights Delivered to Your Inbox</h2> <!-- Updated -->
						</div>
						<a href="#" class="main-btn main-btn-3">Subscribe Now</a> <!-- Link to subscription form/modal -->
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
<!--====== CTA End ======-->

<!--====== Client Area Start ======-->
<section class="client-section">
	<div class="container">
		<div class="client-slider section-gap line-bottom">
			<div class="row align-items-center justify-content-between" id="clientSlider">
				<!-- Client logos - keep placeholders -->
				<div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="162" height="90" src="assets/img/clients/01.avif" srcset="assets/img/clients/01.avif 162w" sizes="(max-width: 768px) 100vw, 162px" alt="Client Logo 1"></a></div>
				<div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="193" height="85" src="assets/img/clients/02.avif" srcset="assets/img/clients/02.avif 193w" sizes="(max-width: 768px) 100vw, 193px" alt="Client Logo 2"></a></div>
				<div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="117" height="95" src="assets/img/clients/03.avif" srcset="assets/img/clients/03.avif 117w" sizes="(max-width: 768px) 100vw, 117px" alt="Client Logo 3"></a></div>
				<div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="164" height="93" src="assets/img/clients/04.avif" srcset="assets/img/clients/04.avif 164w" sizes="(max-width: 768px) 100vw, 164px" alt="Client Logo 4"></a></div>
				<div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="104" height="96" src="assets/img/clients/05.avif" srcset="assets/img/clients/05.avif 104w" sizes="(max-width: 768px) 100vw, 104px" alt="Client Logo 5"></a></div>
				<div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="162" height="90" src="assets/img/clients/01.avif" srcset="assets/img/clients/01.avif 162w" sizes="(max-width: 768px) 100vw, 162px" alt="Client Logo 6"></a></div>
				<div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="193" height="85" src="assets/img/clients/02.avif" srcset="assets/img/clients/02.avif 193w" sizes="(max-width: 768px) 100vw, 193px" alt="Client Logo 7"></a></div>
				<div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="117" height="95" src="assets/img/clients/03.avif" srcset="assets/img/clients/03.avif 117w" sizes="(max-width: 768px) 100vw, 117px" alt="Client Logo 8"></a></div>
				<div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="164" height="93" src="assets/img/clients/04.avif" srcset="assets/img/clients/04.avif 164w" sizes="(max-width: 768px) 100vw, 164px" alt="Client Logo 9"></a></div>
				<div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="104" height="96" src="assets/img/clients/05.avif" srcset="assets/img/clients/05.avif 104w" sizes="(max-width: 768px) 100vw, 104px" alt="Client Logo 10"></a></div>
			</div>
		</div>
	</div>
</section>
<!--====== Client Area End ======-->
</BaseLayout>
