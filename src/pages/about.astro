---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="RevelTek | About us"
  description="About RevelTek Inc. US-based business and technology consulting with 20+ years of experience. Read our story, mission, and values."
  canonicalPath="/about.html"
  ogImage="https://reveltek.com/assets/img/illustration/01.avif"
  header="inner"
  footer="inner"
  heroPreload="/assets/img/breadcrumb.avif">
<!--====== Breadcrumb part Start ======-->
    <section class="breadcrumb-section bg-img-c" style="background-image: url(assets/img/breadcrumb.avif);">
        <div class="container">
            <div class="breadcrumb-text">
                <h1 class="page-title">About Us</h1>
                <ul>
                    <li><a href="index.html">Home</a></li>
                    <li>About Us</li>
                </ul>
            </div>
        </div>
        <div class="breadcrumb-shapes">
            <div class="one"></div>
            <div class="two"></div>
            <div class="three"></div>
        </div>
    </section>
    <!--====== Breadcrumb part End ======-->

    <!--====== About Section start ======-->
    <section class="about-section about-illustration-img section-gap">
        <div class="container">
            <div class="illustration-img">
                <img loading="eager" fetchpriority="high" decoding="async" width="654" height="556" src="assets/img/illustration/01.avif" srcset="assets/img/illustration/01.avif 654w" sizes="(max-width: 768px) 100vw, 654px" alt="About RevelTek illustration">
            </div>
            <div class="row no-gutters justify-content-lg-end justify-content-center">
                <div class="col-lg-6 col-md-10">
                    <div class="about-text">
                        <div class="section-title left-border mb-40">
                            <span class="title-tag">About Us</span>
                            <h2 class="title">Business And Technology <br> Consulting That Delivers</h2>
                        </div>
                        <p class="mb-25">
                            RevelTek Inc. is a US-based business and technology consulting firm. We bring 20+
                            years of experience to every engagement.
                        </p>
                        <p>
                            We help teams choose the right technology and ship software that supports growth.
                        </p>
                        <ul class="about-list">
                            <li> <i class="far fa-check"></i>{' '}US-Based Team With 20+ Years Of Experience</li>
                            <li> <i class="far fa-check"></i>{' '}Outcome-Led Work, From Roadmap To Results</li>
                        </ul>
                        <a href="studies.html" class="main-btn">See Our Work</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--====== About Section end ======-->

    <!--====== Service Section Start ======-->
    <section class="service-section grey-bg service-line-shape section-gap">
        <div class="container">
            <!-- Section Title -->
            <div class="section-title text-center both-border mb-50">
                <span class="title-tag">What We Do</span>
                <h2 class="title">Services That Move <br> Your Business Forward</h2>
            </div>
            <!-- Services Boxes -->
            <div class="row service-boxes justify-content-center">
                <div class="col-lg-3 col-sm-6 col-10 wow fadeInLeft" data-wow-duration="1500ms" data-wow-delay="400ms">
                    <div class="service-box-three border-0">
                        <div class="icon">
                            <img loading="lazy" decoding="async" width="103" height="100" src="assets/img/icons/01.avif" srcset="assets/img/icons/01.avif 103w" sizes="(max-width: 768px) 100vw, 103px" alt="Software and SaaS icon">
                        </div>
                        <h3><a href="service-details.html">Software And SaaS</a></h3>
                        <p>We design and build software your team can run and grow.</p>
                        <a href="service-details.html" class="service-link">
                            <i class="fal fa-long-arrow-right"></i>
                        </a>
                    </div>
                </div>
                <div class="col-lg-3 col-sm-6 col-10 wow fadeInUp" data-wow-duration="1500ms" data-wow-delay="500ms">
                    <div class="service-box-three border-0">
                        <div class="icon">
                            <img loading="lazy" decoding="async" width="101" height="101" src="assets/img/icons/02.avif" srcset="assets/img/icons/02.avif 101w" sizes="(max-width: 768px) 100vw, 101px" alt="IT Strategy Consulting icon">
                        </div>
                        <h3><a href="service-details.html">IT Strategy Consulting</a></h3>
                        <p>You get a clear roadmap tied to business goals.</p>
                        <a href="service-details.html" class="service-link">
                            <i class="fal fa-long-arrow-right"></i>
                        </a>
                    </div>
                </div>
                <div class="col-lg-3 col-sm-6 col-10 wow fadeInUp" data-wow-duration="1500ms" data-wow-delay="600ms">
                    <div class="service-box-three border-0">
                        <div class="icon">
                            <img loading="lazy" decoding="async" width="100" height="100" src="assets/img/icons/03.avif" srcset="assets/img/icons/03.avif 100w" sizes="(max-width: 768px) 100vw, 100px" alt="AI icon">
                        </div>
                        <h3><a href="service-details.html">AI</a></h3>
                        <p>We find practical uses for AI and help you pilot them.</p>
                        <a href="service-details.html" class="service-link">
                            <i class="fal fa-long-arrow-right"></i>
                        </a>
                    </div>
                </div>
                <div class="col-lg-3 col-sm-6 col-10 wow fadeInRight" data-wow-duration="1500ms" data-wow-delay="700ms">
                    <div class="service-box-three border-0">
                        <div class="icon">
                            <img loading="lazy" decoding="async" width="100" height="100" src="assets/img/icons/04.avif" srcset="assets/img/icons/04.avif 100w" sizes="(max-width: 768px) 100vw, 100px" alt="Cloud and Analytics icon">
                        </div>
                        <h3><a href="service-details.html">Cloud And Analytics</a></h3>
                        <p>We move systems to the cloud and turn data into decisions.</p>
                        <a href="service-details.html" class="service-link">
                            <i class="fal fa-long-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="line-one">
            <img loading="lazy" decoding="async" width="376" height="353" src="assets/img/lines/12.avif" srcset="assets/img/lines/12.avif 376w" sizes="(max-width: 768px) 100vw, 376px" alt="line-shape">
        </div>
        <div class="line-two">
            <img loading="lazy" decoding="async" width="537" height="499" src="assets/img/lines/11.avif" srcset="assets/img/lines/11.avif 537w" sizes="(max-width: 768px) 100vw, 537px" alt="line-shape">
        </div>
    </section>
    <!--====== Service Section End ======-->

    <!--====== Advanced Tabs Section Start ======-->
    <section class="advanced-tab section-gap">
        <div class="container">
            <!-- Tabs Buttons -->
            <div class="tab-buttons">
                <div class="nav nav-tabs" id="nav-tab" role="tablist">
                    <a class="active" id="nav-mission" data-toggle="tab" href="#tab-mission" role="tab">Our Mission &
                        Vision</a>
                    <a id="nav-history" data-toggle="tab" href="#tab-history" role="tab">Company History</a>
                    <a id="nav-business" data-toggle="tab" href="#tab-business" role="tab">Business Goals</a>
                    <a id="nav-team" data-toggle="tab" href="#tab-team" role="tab">Team Member</a>
                </div>
                <div class="tab-content" id="nav-tabContent">
                    <div class="tab-pane fade show active" id="tab-mission" role="tabpanel">
                        <div class="tab-text-block left-image with-left-circle">
                            <div class="row align-items-center justify-content-center">
                                <div class="col-lg-6 col-md-10">
                                    <div class="block-image">
                                        <img loading="lazy" decoding="async" width="570" height="520" src="assets/img/tab-block.avif" srcset="assets/img/tab-block.avif 570w" sizes="(max-width: 768px) 100vw, 570px" alt="About RevelTek company overview">
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-10">
                                    <div class="block-text">
                                        <h2 class="title">Our Mission And Vision</h2>
                                        <p>
                                            Our mission is simple. Help clients use technology well. Our vision is to be the partner US teams call first when outcomes matter.
                                        </p>
                                        <ul>
                                            <li>
                                                <i class="fas fa-check"></i>{' '}Outcomes over activity. Every task ties to a result.
                                            </li>
                                            <li>
                                                <i class="fas fa-check"></i>{' '}Plain talk over jargon. You always know where work stands.
                                            </li>
                                            <li>
                                                <i class="fas fa-check"></i>{' '}Partnership over transactions. We hand over what we build.
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="tab-history" role="tabpanel">
                        <div class="tab-text-block right-image with-right-circle">
                            <div class="row align-items-center justify-content-center">
                                <div class="col-lg-6 col-md-10 order-2 order-lg-1">
                                    <div class="block-text">
                                        <h2 class="title">Our Story</h2>
                                        <p>
                                            RevelTek started with a practical idea. Business advice and software delivery belong together. For 20+ years we have helped US teams plan, build, and run technology across health, fintech, retail, and more.
                                        </p>
                                        <ul>
                                            <li>
                                                <i class="fas fa-check"></i>{' '}20+ years across software, consulting, AI, cloud, and analytics.
                                            </li>
                                            <li>
                                                <i class="fas fa-check"></i>{' '}Experience in health, fintech, retail, and other industries.
                                            </li>
                                            <li>
                                                <i class="fas fa-check"></i>{' '}Clients who stay and grow the work with us.
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-10 order-1 order-lg-2">
                                    <div class="block-image">
                                        <img loading="lazy" decoding="async" width="570" height="520" src="assets/img/tab-block.avif" srcset="assets/img/tab-block.avif 570w" sizes="(max-width: 768px) 100vw, 570px" alt="About RevelTek company overview">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="tab-business" role="tabpanel">
                        <div class="tab-text-block left-image with-left-circle">
                            <div class="row align-items-center justify-content-center">
                                <div class="col-lg-6 col-md-10">
                                    <div class="block-image">
                                        <img loading="lazy" decoding="async" width="570" height="520" src="assets/img/tab-block.avif" srcset="assets/img/tab-block.avif 570w" sizes="(max-width: 768px) 100vw, 570px" alt="About RevelTek company overview">
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-10">
                                    <div class="block-text">
                                        <h2 class="title">What We Aim For</h2>
                                        <p>
                                            Every engagement has clear goals. We set them with you at the start. Then we deliver against them.
                                        </p>
                                        <ul>
                                            <li>
                                                <i class="fas fa-check"></i>{' '}Systems that support growth instead of slowing it.
                                            </li>
                                            <li>
                                                <i class="fas fa-check"></i>{' '}Costs that stay visible and under control.
                                            </li>
                                            <li>
                                                <i class="fas fa-check"></i>{' '}Teams that can run and extend what we build.
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="tab-team" role="tabpanel">
                        <div class="tab-text-block right-image with-right-circle">
                            <div class="row align-items-center justify-content-center">
                                <div class="col-lg-6 col-md-10 order-2 order-lg-1">
                                    <div class="block-text">
                                        <h2 class="title">How We Work With You</h2>
                                        <p>
                                            You work directly with the people doing the work. No handoffs into the dark. We plan together, build in small steps, and review often.
                                        </p>
                                        <ul>
                                            <li>
                                                <i class="fas fa-check"></i>{' '}Direct access to consultants and engineers.
                                            </li>
                                            <li>
                                                <i class="fas fa-check"></i>{' '}Small releases you can review and test.
                                            </li>
                                            <li>
                                                <i class="fas fa-check"></i>{' '}Full handover with docs and training.
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-10 order-1 order-lg-2">
                                    <div class="block-image">
                                        <img loading="lazy" decoding="async" width="570" height="520" src="assets/img/tab-block.avif" srcset="assets/img/tab-block.avif 570w" sizes="(max-width: 768px) 100vw, 570px" alt="About RevelTek company overview">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--====== Advanced Tabs Section End ======-->

    <!--====== Video Start ======-->
    <section class="video-section-two bg-img-c" style="background-image: url(assets/img/video-bg/video-2.avif);">
        <div class="container">
            <div class="row align-content-center justify-content-center">
                <div class="col-lg-10">
                    <div class="video-cont text-center">
                        <a href="https://www.youtube.com/watch?v=fEErySYqItI"
                            class="play-btn popup-video wow fadeInLeft" data-wow-duration="1500ms"
                            data-wow-delay="400ms"><i class="fas fa-play"></i></a>
                        <h2>
                            Watch Our Latest Videos For Better Innovative Business
                        </h2>
                    </div>
                </div>
            </div>
        </div>
        <div class="line-shape-one">
            <img loading="lazy" decoding="async" width="376" height="353" src="assets/img/lines/12.avif" srcset="assets/img/lines/12.avif 376w" sizes="(max-width: 768px) 100vw, 376px" alt="Line">
        </div>
        <div class="line-shape-two">
            <img loading="lazy" decoding="async" width="537" height="499" src="assets/img/lines/11.avif" srcset="assets/img/lines/11.avif 537w" sizes="(max-width: 768px) 100vw, 537px" alt="Line">
        </div>
    </section>
    <!--====== Video end ======-->

    <!--====== Testimonials Section start ======-->
    <section class="testimonial-section-three no-bg">
        <div class="container">
            <div class="row justify-content-center no-gutters">
                <div class="col-lg-10">
                    <div class="testimonial-items" id="testimonialSliderThree">
                        <div class="testimonial-item text-center">
                            <div class="author-thumb">
                                <img loading="lazy" decoding="async" width="120" height="120" src="assets/img/testimonial/author-9.avif" srcset="assets/img/testimonial/author-9.avif 120w" sizes="(max-width: 768px) 100vw, 120px" alt="Healthcare client portrait">
                            </div>

                            <div class="content">
                                <p>
                                    <span class="quote-top">
                                        <i class="fal fa-quote-left"></i>
                                    </span>
                                    RevelTek reviewed our systems and gave us a clear order of work. We stopped guessing and started shipping.
                                    <span class="quote-bottom">
                                        <i class="fal fa-quote-right"></i>
                                    </span>
                                </p>
                            </div>

                            <div class="author">
                                <h4>Operations Director</h4>
                                <span>Healthcare</span>
                            </div>
                        </div>
                        <div class="testimonial-item text-center">
                            <div class="author-thumb">
                                <img loading="lazy" decoding="async" width="120" height="120" src="assets/img/testimonial/author-9.avif" srcset="assets/img/testimonial/author-9.avif 120w" sizes="(max-width: 768px) 100vw, 120px" alt="Fintech client portrait">
                            </div>

                            <div class="content">
                                <p>
                                    <span class="quote-top">
                                        <i class="fal fa-quote-left"></i>
                                    </span>
                                    They tied every tech decision to a business goal. Our roadmap finally made sense to the whole team.
                                    <span class="quote-bottom">
                                        <i class="fal fa-quote-right"></i>
                                    </span>
                                </p>
                            </div>

                            <div class="author">
                                <h4>Founder</h4>
                                <span>Fintech</span>
                            </div>
                        </div>
                        <div class="testimonial-item text-center">
                            <div class="author-thumb">
                                <img loading="lazy" decoding="async" width="120" height="120" src="assets/img/testimonial/author-9.avif" srcset="assets/img/testimonial/author-9.avif 120w" sizes="(max-width: 768px) 100vw, 120px" alt="Retail client portrait">
                            </div>

                            <div class="content">
                                <p>
                                    <span class="quote-top">
                                        <i class="fal fa-quote-left"></i>
                                    </span>
                                    Direct people. Clear costs. Working software in small releases. That is why we kept them on.
                                    <span class="quote-bottom">
                                        <i class="fal fa-quote-right"></i>
                                    </span>
                                </p>
                            </div>

                            <div class="author">
                                <h4>IT Manager</h4>
                                <span>Retail</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--====== Testimonials Section end ======-->

    <!--====== Client Area Start ======-->
    <section class="client-section">
        <div class="container">
            <div class="client-slider section-gap line-top">
                <div class="row align-items-center justify-content-between" id="clientSlider">
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="162" height="90" src="assets/img/clients/01.avif" srcset="assets/img/clients/01.avif 162w" sizes="(max-width: 768px) 100vw, 162px" alt="Client logo 1">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="193" height="85" src="assets/img/clients/02.avif" srcset="assets/img/clients/02.avif 193w" sizes="(max-width: 768px) 100vw, 193px" alt="Client logo 2">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="117" height="95" src="assets/img/clients/03.avif" srcset="assets/img/clients/03.avif 117w" sizes="(max-width: 768px) 100vw, 117px" alt="Client logo 3">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="164" height="93" src="assets/img/clients/04.avif" srcset="assets/img/clients/04.avif 164w" sizes="(max-width: 768px) 100vw, 164px" alt="Client logo 4">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="104" height="96" src="assets/img/clients/05.avif" srcset="assets/img/clients/05.avif 104w" sizes="(max-width: 768px) 100vw, 104px" alt="Client logo 5">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="162" height="90" src="assets/img/clients/01.avif" srcset="assets/img/clients/01.avif 162w" sizes="(max-width: 768px) 100vw, 162px" alt="Client logo 1">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="193" height="85" src="assets/img/clients/02.avif" srcset="assets/img/clients/02.avif 193w" sizes="(max-width: 768px) 100vw, 193px" alt="Client logo 2">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="117" height="95" src="assets/img/clients/03.avif" srcset="assets/img/clients/03.avif 117w" sizes="(max-width: 768px) 100vw, 117px" alt="Client logo 3">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="164" height="93" src="assets/img/clients/04.avif" srcset="assets/img/clients/04.avif 164w" sizes="(max-width: 768px) 100vw, 164px" alt="Client logo 4">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="104" height="96" src="assets/img/clients/05.avif" srcset="assets/img/clients/05.avif 104w" sizes="(max-width: 768px) 100vw, 104px" alt="Client logo 5">
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--====== Client Area End ======-->
</BaseLayout>
