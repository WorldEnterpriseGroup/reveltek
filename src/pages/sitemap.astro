---
import BaseLayout from '../layouts/BaseLayout.astro';
import baseline from '../../.astro-magazine/adoption/route-baseline.json';

interface RouteEntry {
  url: string;
  title: string;
  family: string;
}

// Mirror the astro.config.mjs sitemap filter: never list retired noindex
// redirect stubs (awards/culture/government/jobs), the 404 page, the noindex
// commerce pages (cart/checkout/shop/product-details), or the noindex
// canonical-consolidated variants (index-2/index-3/blog-grid/blog-standard/
// services-2/portfolio-2). The visual inventory lists exactly the indexable
// routes — same filter intent as sitemap-0.xml + robots.
const EXCLUDED_IDS = new Set([
  'awards',
  'culture',
  'government',
  'jobs',
  '404',
  'cart',
  'checkout',
  'shop',
  'product-details',
  'index-2',
  'index-3',
  'blog-grid',
  'blog-standard',
  'services-2',
  'portfolio-2',
]);

const routeId = (url: string) => url.replace(/^\//, '').replace(/\.html$/, '');
const routes = (baseline.routes as RouteEntry[]).filter((r) => !EXCLUDED_IDS.has(routeId(r.url)));

const families = [...new Set(routes.map((r) => r.family))];
const byFamily = (f: string) => routes.filter((r) => r.family === f);
---

<BaseLayout
  title="Sitemap — RevelTek | Business & Technology Consulting"
  description="Every RevelTek page in one place: services, industries, insights, company, work, shop, careers, and contact."
  canonicalPath="/sitemap.html"
  ogImage="https://reveltek.com/assets/img/logo.avif"
>
  <section class="breadcrumb-area" style="padding: 90px 0 30px;">
    <div class="container">
      <h1>Visual Sitemap</h1>
      <p>{routes.length} indexable pages on reveltek.com, grouped by section. One hop to anything.</p>
    </div>
  </section>
  <section style="padding: 20px 0 90px;">
    <div class="container">
      <div class="row">
        {
          families.map((family) => (
            <div class="col-lg-4 col-md-6" style="margin-bottom: 32px;">
              <h2 style="text-transform: capitalize; font-size: 1.4rem;">{family}</h2>
              <ul>
                {byFamily(family).map((r) => (
                  <li>
                    <a href={r.url.replace(/^\//, '')}>{r.title}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
