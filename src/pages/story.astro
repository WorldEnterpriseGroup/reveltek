---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="RevelTek | Our Story"
  description="Learn about RevelTek's story, mission, values, and our 'revel in technology' philosophy driving innovation for over 20 years."
  canonicalPath="/story.html"
  ogImage="https://reveltek.com/assets/img/details/project-big-img.avif"
  header="contact"
  footer="company"
  heroPreload="/assets/img/breadcrumb.avif">
<!--====== Breadcrumb part Start ======-->
    <section class="breadcrumb-section bg-img-c" style="background-image: url(assets/img/breadcrumb.avif);">
        <div class="container">
            <div class="breadcrumb-text">
                <!-- Updated Title -->
                <h1 class="page-title">Our Story</h1>
                <ul>
                    <!-- Updated Path -->
                    <li>About</li>
                    <li>Story</li>
                </ul>
            </div>
        </div>
        <div class="breadcrumb-shapes">
            <div class="one"></div>
            <div class="two"></div>
            <div class="three"></div>
        </div>
    </section>
    <!--====== Breadcrumb part End ======-->

    <!--====== Story Section Start (Using Project Details Layout) ======-->
    <section class="service-details section-gap"> <!-- Changed class from project-details -->
        <div class="container">
            <!-- Removed project-thumb -->

            <div class="project-content mt-60"> <!-- Reusing project-content class -->
                <div class="row justify-content-center"> <!-- Center content -->
                    <div class="col-lg-10"> <!-- Use wider column -->
                        <div class="content">
                            <!-- Updated Title -->
                            <h2>RevelTek: Innovation Through Technology</h2>

                             <!-- Updated Main Content - Replace with actual story -->
                            <p class="mb-40">
                                For over twenty years, RevelTek has been a trusted US based technical consulting partner. We are dedicated to empowering businesses through cutting edge solutions. Our journey began with a passion for technology and a belief in its power to transform organizations. We started by helping clients navigate complex IT challenges, building a reputation for delivering robust and scalable systems tailored to specific needs.
                            </p>
                            <div class="main-thumb mb-40"> <!-- Image moved inside content flow -->
                                <img loading="eager" fetchpriority="high" decoding="async" width="1170" height="690" src="assets/img/details/project-big-img.avif" srcset="assets/img/details/project-big-img.avif 1170w" sizes="(max-width: 768px) 100vw, 1170px" alt="RevelTek Team Collaboration"> <!-- Update Image & Alt -->
                            </div>
                            <h3>Our Mission & Vision</h3>
                            <p>
                                Our mission is to turn complex technical problems into opportunities for client growth, efficiency, and competitive advantage. We strive to be leaders in SaaS development, AI implementation, cloud strategy, and expert IT consulting. Our vision is a future where technology seamlessly enhances every business operation, driven by our core values of integrity, partnership, innovation, and excellence always.
                            </p>
                            <h3 class="mt-40">The "Revel in Technology" Philosophy</h3>
                            <p class="mb-40">
                                This phrase captures our core belief. We genuinely enjoy exploring, understanding, and applying technology. It means we are constantly learning, experimenting, and finding creative ways to solve problems. This passion translates into better solutions for our clients and a dynamic, engaging work environment for our team members. We believe this enthusiasm is key to our long term success and client satisfaction.
                            </p>

                            <!-- Re-purposed section, maybe for key milestones or values -->
                            <div class="row align-items-center justify-content-center mt-50">
                                <div class="col-lg-6">
                                    <div class="image text-center mb-40">
                                        <img loading="lazy" decoding="async" width="370" height="350" src="assets/img/details/service-02.avif" srcset="assets/img/details/service-02.avif 370w" sizes="(max-width: 768px) 100vw, 370px" alt="Company Values Graphic"> <!-- Update Image & Alt -->
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <h3 class="sub-title">Core Values</h3>
                                    <ul class="check-list mt-30 mb-40">
                                        <li><i class="fas fa-check"></i>Client Partnership First</li>
                                        <li><i class="fas fa-check"></i>Innovation Driven Solutions</li>
                                        <li><i class="fas fa-check"></i>Integrity In All Actions</li>
                                        <li><i class="fas fa-check"></i>Commitment To Excellence</li>
                                    </ul>
                                </div>
                            </div>
                             <!-- Removed original image gallery ('thumbs') and final paragraph -->
                        </div>
                    </div>
                     <!-- Removed original sidebar column -->
                </div>
            </div>
        </div>
    </section>
    <!--====== Story Section End ======-->

    <!--====== CTA Start ======-->
    <section class="cta-aection">
        <div class="container">
            <div class="cta-wrap bg-img-c" style="background-image: url(assets/img/lines/16.avif);">
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <div class="cta-content text-center">
                            <div class="section-title both-border mb-30">
                                <span class="title-tag">Partner With Us</span> <!-- Updated -->
                                <h2 class="title">Ready To Start Your Next Chapter With RevelTek?</h2> <!-- Updated -->
                            </div>
                            <!-- Updated Link -->
                            <a href="contact.html" class="main-btn main-btn-3">Contact Our Team</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--====== CTA End ======-->

    <!--====== Client Area Start ======-->
    <section class="client-section">
        <div class="container">
            <div class="client-slider section-gap line-top">
                <div class="row align-items-center justify-content-between" id="clientSlider">
                    <!-- Client logos - keep placeholders -->
                    <div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="162" height="90" src="assets/img/clients/01.avif" srcset="assets/img/clients/01.avif 162w" sizes="(max-width: 768px) 100vw, 162px" alt="Client Logo 1"></a></div>
                    <div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="193" height="85" src="assets/img/clients/02.avif" srcset="assets/img/clients/02.avif 193w" sizes="(max-width: 768px) 100vw, 193px" alt="Client Logo 2"></a></div>
                    <div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="117" height="95" src="assets/img/clients/03.avif" srcset="assets/img/clients/03.avif 117w" sizes="(max-width: 768px) 100vw, 117px" alt="Client Logo 3"></a></div>
                    <div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="164" height="93" src="assets/img/clients/04.avif" srcset="assets/img/clients/04.avif 164w" sizes="(max-width: 768px) 100vw, 164px" alt="Client Logo 4"></a></div>
                    <div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="104" height="96" src="assets/img/clients/05.avif" srcset="assets/img/clients/05.avif 104w" sizes="(max-width: 768px) 100vw, 104px" alt="Client Logo 5"></a></div>
                    <div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="162" height="90" src="assets/img/clients/01.avif" srcset="assets/img/clients/01.avif 162w" sizes="(max-width: 768px) 100vw, 162px" alt="Client Logo 6"></a></div>
                    <div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="193" height="85" src="assets/img/clients/02.avif" srcset="assets/img/clients/02.avif 193w" sizes="(max-width: 768px) 100vw, 193px" alt="Client Logo 7"></a></div>
                    <div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="117" height="95" src="assets/img/clients/03.avif" srcset="assets/img/clients/03.avif 117w" sizes="(max-width: 768px) 100vw, 117px" alt="Client Logo 8"></a></div>
                    <div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="164" height="93" src="assets/img/clients/04.avif" srcset="assets/img/clients/04.avif 164w" sizes="(max-width: 768px) 100vw, 164px" alt="Client Logo 9"></a></div>
                    <div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="104" height="96" src="assets/img/clients/05.avif" srcset="assets/img/clients/05.avif 104w" sizes="(max-width: 768px) 100vw, 104px" alt="Client Logo 10"></a></div>
                </div>
            </div>
        </div>
    </section>
    <!--====== Client Area End ======-->
</BaseLayout>
