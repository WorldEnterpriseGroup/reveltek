    <!--====== Video Start ======-->
    <section class="video-section bg-img-c section-gap" style="background-image: url(assets/img/video-bg/video-1.avif);">
        <div class="container">
            <div class="row align-items-center justify-content-between">
                <div class="col-xl-7 col-lg-8 col-md-10 order-2 order-md-1">
                    <div class="video-text">
                        <div class="section-title left-border mb-30">
                            <span class="title-tag">How We Work</span>
                            <h2 class="title">
                                Assess, Roadmap, Build, Operate — <br> With Your Team
                            </h2>
                        </div>
                        <p>
                            Every engagement starts with an honest assessment of your systems, spend, and
                            delivery bottlenecks. We agree a sequenced roadmap with owners and measurable
                            outcomes, build the highest-value changes first, and hand over operations that
                            your team can run.
                        </p>
                        <a href="contact.html" class="main-btn">Start A Conversation</a>
                    </div>
                </div>
                <div class="col-lg-3 col-lg-4 col-md-2 order-1 order-md-2">
                    <div class="video-btn text-md-center">
                    </div>
                </div>
            </div>
        </div>
        <div class="line-shape">
            <img loading="lazy" decoding="async" width="1263" height="597" src="assets/img/lines/08.avif" srcset="assets/img/lines/08.avif 1263w" sizes="(max-width: 768px) 100vw, 1263px" alt="Line">
        </div>
    </section>
    <!--====== Video end ======-->

    <!--====== Skill Section Start ======-->
    <section class="skill-section section-gap-top">
        <div class="container">
            <div class="row align-items-center justify-content-center">
                <div class="col-lg-6 col-md-10">
                    <!-- Skill Text Block -->
                    <div class="skill-text">
                        <div class="section-title mb-40 left-border">
                            <span class="title-tag">Our Capabilities</span>
                            <h2 class="title">Advisors Organized <br> Around Outcomes</h2>
                        </div>
                        <p>
                            RevelTek advisors work across fintech, health, retail, and education — covering
                            platform strategy, cloud migration, AI and analytics, and commerce delivery. Each
                            engagement gets a team matched to the outcome, not whoever happens to be free.
                        </p>
                        <p>
                            Deliverables are concrete: a current-state assessment, a prioritized roadmap with
                            owners and timelines, implementation support, and an operating handover with
                            runbooks. Representative profiles above — <a href="contact.html">contact us</a>
                            to discuss the right mix for your scope.
                        </p>

                        <a href="contact.html" class="main-btn">Contact Us</a>
                    </div>
                </div>
                <div class="col-lg-6 col-md-10">
                    <div class="piechart-boxes">
                        <div class="chart-box">
                            <div class="chart" data-percent="25">
                                <i class="flaticon-presentation"></i>
                            </div>
                            <h4 class="title">Business Strategy</h4>
                        </div>
                        <div class="chart-box">
                            <div class="chart" data-percent="40">
