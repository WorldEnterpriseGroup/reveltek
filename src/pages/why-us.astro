---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="RevelTek | Why Choose Us"
  description="Discover why RevelTek is the right technology partner: 20+ years experience, award-winning innovation, client-focused approach."
  canonicalPath="/why-us.html"
  header="contact"
  footer="company"
>
<!--====== Breadcrumb part Start ======-->
    <section class="breadcrumb-section bg-img-c" style="background-image: url(assets/img/breadcrumb.avif);">
        <div class="container">
            <div class="breadcrumb-text">
                 <!-- Updated Title -->
                <h1 class="page-title">Why Choose Us</h1>
                <ul>
                     <!-- Updated Path -->
                    <li>About</li>
                    <li>Why Us</li>
                </ul>
            </div>
        </div>
        <div class="breadcrumb-shapes">
            <div class="one"></div>
            <div class="two"></div>
            <div class="three"></div>
        </div>
    </section>
    <!--====== Breadcrumb part End ======-->

    <!--====== Why Us Section Start (Using Project Details Layout) ======-->
    <section class="project-details section-gap"> <!-- Reusing project-details styles -->
        <div class="container">
            <div class="project-thumb">
                 <!-- Update Image & Alt Text -->
                <img fetchpriority="high" decoding="async" width="1170" height="690" src="assets/img/details/project-big-img.avif" alt="RevelTek Team Working on Solutions">
            </div>

            <div class="project-content mt-60">
                <div class="row">
                    <div class="col-lg-8 order-2 order-lg-1"> <!-- Adjusted order -->
                        <div class="content">
                            <!-- Updated Title -->
                            <h2>The RevelTek Advantage: Experience, Innovation, Partnership</h2>

                             <!-- Updated Content -->
                            <p class="mb-40">
                                Choosing the right technology partner is crucial for success. At RevelTek, we combine over two decades of proven experience with a forward thinking approach. We are passionate about technology ("revel in technology") and dedicated to translating that passion into real world results for our clients. Our team doesn't just build software; we build strategic partnerships focused on your growth and efficiency.
                            </p>

                             <!-- Updated Content -->
                            <p>
                                We pride ourselves on understanding the nuances of your industry and applying the right technology—whether it's cutting edge AI, robust SaaS platforms, or scalable cloud infrastructure. Our award winning advancements, particularly in AI, demonstrate our commitment to staying ahead of the curve and delivering innovative solutions that provide a true competitive edge for businesses we serve.
                            </p>
                        </div>
                    </div>

                    <div class="col-lg-4 order-1 order-lg-2">
                        <div class="details">
                            <!-- Updated Details Section to Differentiators -->
                            <ul>
                                <li>
                                    <h3>Proven Expertise</h3>
                                    <p>20+ Years Delivering Results</p>
                                </li>
                                <li>
                                    <h3>Innovation Driven</h3>
                                    <p>Award Winning AI & Tech Focus</p>
                                </li>
                                <li>
                                    <h3>Client Partnership</h3>
                                    <p>Collaborative Approach Always</p>
                                </li>
                                <li>
                                    <h3>Industry Knowledge</h3>
                                    <p>Tailored Sector Solutions</p>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="col-12 order-3">
                        <!-- Repurposed Thumbs Section for Awards/Innovation Graphics -->
                        <div class="thumbs mt-40"> <!-- Added margin -->
                             <h3 class="text-center mb-30">Recognized for Excellence</h3> <!-- Added heading -->
                            <div class="row justify-content-center">
                                <div class="col-md-4 col-sm-6 text-center mb-30"> <!-- Added margin-bottom -->
                                    <img loading="lazy" decoding="async" width="370" height="445" src="assets/img/details/project-01.avif" alt="Award Logo 1"> <!-- Update Image & Alt -->
                                    <p>AI Innovation Award 2023</p> <!-- Example Award Text -->
                                </div>
                                <div class="col-md-4 col-sm-6 text-center mb-30">
                                    <img loading="lazy" decoding="async" width="370" height="445" src="assets/img/details/project-02.avif" alt="Award Logo 2"> <!-- Update Image & Alt -->
                                    <p>Top SaaS Provider 2024</p> <!-- Example Award Text -->
                                </div>
                                <div class="col-md-4 col-sm-6 text-center mb-30">
                                    <img loading="lazy" decoding="async" width="370" height="445" src="assets/img/details/project-03.avif" alt="Experience Badge"> <!-- Update Image & Alt -->
                                     <p>20+ Years of Service</p> <!-- Example Text -->
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 order-4">
                        <div class="content mt-40"> <!-- Added margin -->
                             <!-- Updated Final Paragraph -->
                            <p>
                                Ultimately, we succeed when you succeed. Our focus remains on understanding your unique goals and leveraging our extensive technical capabilities and collaborative spirit to help you achieve them. Partner with RevelTek and experience the difference that true expertise and a commitment to innovation can make for your organization's future. Let's build success together.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--====== Why Us Section End ======-->

    <!--====== CTA Start ======-->
    <section class="cta-aection">
        <div class="container">
            <div class="cta-wrap bg-img-c" style="background-image: url(assets/img/lines/16.avif);">
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <div class="cta-content text-center">
                            <div class="section-title both-border mb-30">
                                <span class="title-tag">Work With Us</span> <!-- Updated -->
                                <h2 class="title">Ready to Leverage Our Expertise for Your Next Project?</h2> <!-- Updated -->
                            </div>
                            <!-- Updated Link -->
                            <a href="contact.html" class="main-btn main-btn-3">Get Started Today</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--====== CTA End ======--> <!-- Corrected Comment -->

    <!--====== Client Area Start ======-->
    <section class="client-section">
        <div class="container">
            <div class="client-slider section-gap line-top">
                <div class="row align-items-center justify-content-between" id="clientSlider">
                    <!-- Client logos - keep placeholders -->
                    <div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="162" height="90" src="assets/img/clients/01.avif" alt="Client Logo 1"></a></div>
                    <div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="193" height="85" src="assets/img/clients/02.avif" alt="Client Logo 2"></a></div>
                    <div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="117" height="95" src="assets/img/clients/03.avif" alt="Client Logo 3"></a></div>
                    <div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="164" height="93" src="assets/img/clients/04.avif" alt="Client Logo 4"></a></div>
                    <div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="104" height="96" src="assets/img/clients/05.avif" alt="Client Logo 5"></a></div>
                    <div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="162" height="90" src="assets/img/clients/01.avif" alt="Client Logo 6"></a></div>
                    <div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="193" height="85" src="assets/img/clients/02.avif" alt="Client Logo 7"></a></div>
                    <div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="117" height="95" src="assets/img/clients/03.avif" alt="Client Logo 8"></a></div>
                    <div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="164" height="93" src="assets/img/clients/04.avif" alt="Client Logo 9"></a></div>
                    <div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="104" height="96" src="assets/img/clients/05.avif" alt="Client Logo 10"></a></div>
                </div>
            </div>
        </div>
    </section>
    <!--====== Client Area End ======-->
</BaseLayout>
