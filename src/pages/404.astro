  description="The page you requested could not be found. Explore RevelTek services, industries, and insights."
  canonicalPath="/404.html"
>
  <section class="breadcrumb-area" style="padding: 120px 0; text-align: center;">
    <div class="container">
      <h1>Page Not Found</h1>
      <p>The page you requested could not be found. Try one of these instead:</p>
      <ul class="btn-wrap" style="list-style: none; padding: 0;">
        <li style="display: inline-block; margin: 0 8px;">
          <a href="index.html" class="main-btn main-btn-4">Home</a>
        </li>
        <li style="display: inline-block; margin: 0 8px;">
          <a href="services.html" class="main-btn main-btn-2">Services</a>
        </li>
        <li style="display: inline-block; margin: 0 8px;">
          <a href="sitemap.html" class="main-btn main-btn-2">Sitemap</a>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>
