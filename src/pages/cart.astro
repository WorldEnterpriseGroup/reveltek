---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="RevelTek | Product Details"
  description="RevelTek | Product Details"
  canonicalPath="/cart.html"
  ogImage="https://reveltek.com/assets/img/breadcrumb.avif"
  breadcrumbName="Cart"
  header="inner"
  footer="inner"
  noindex
  heroPreload="/assets/img/breadcrumb.avif">
<!--====== Breadcrumb part Start ======-->
    <section class="breadcrumb-section bg-img-c" style="background-image: url(assets/img/breadcrumb.avif);">
        <div class="container">
            <div class="breadcrumb-text">
                <h1 class="page-title">Cart</h1>
                <ul>
                    <li><a href="index.html">Home</a></li>
                    <li>Cart</li>
                </ul>
            </div>
        </div>
        <div class="breadcrumb-shapes">
            <div class="one"></div>
            <div class="two"></div>
            <div class="three"></div>
        </div>
    </section>
    <!--====== Breadcrumb part End ======-->
    <section class="cart-area-section section-gap">
        <div class="container">
            <div class="row">
                <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12">
                    <ul class="total-item-info">
                        <li><strong>Total Items:</strong> <strong class="cart-item-view">1</strong></li>
                        <li><strong>Cart Total :</strong>  <strong class="cart-total-view">$ 60 </strong></li>
                    </ul>
                    <div class="table-outer table-responsive">
                        <table class="cart-table">
                            <thead class="cart-header">
                                <tr>
                                    <th class="prod-column">Products</th>
                                    <th class="hide-column"></th>
                                    <th>Quantity</th>
                                    <th class="availability">Availability</th>
                                    <th class="price">Price</th>
                                    <th>Total</th>
                                    <th class="remove">Remove</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td colspan="2" class="prod-column">
                                        <div class="column-box">
                                            <div class="title pl-0">
                                                <a href="product-details.html"><h3 class="prod-title">Smart Man Jacket</h3></a>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="qty">
                                        <div class="quantity-input">
                                            <div class="quantity-down" id="quantityDown">
                                                <i class="fal fa-minus"></i>
                                            </div>
                                            <input id="quantity" type="text" value="1" name="quantity">
                                            <div class="quantity-up" id="quantityUP">
                                                <i class="fal fa-plus"></i>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="unit-price">
                                        <div class="available-info">
                                            <span class="icon fa fa-check thm-bg-clr"></span>Item(s)<br>Avilable Now
                                        </div>
                                    </td>
                                    <td class="price cart_price">$ <span>60.00</span> </td>
                                    <td class="sub-total">$ <span>60</span> </td>
                                    <td>
                                        <div class="remove">
                                            <div class="checkbox">
                                            <span class="fas fa-times item-remove" rel="4" data-href="#"></span>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="2" class="prod-column">
                                        <div class="column-box">
                                            <div class="title pl-0">
                                                <a href="product-details.html"><h3 class="prod-title">Smart Man Jacket</h3></a>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="qty">
                                        <div class="quantity-input">
                                            <div class="quantity-down" id="quantityDown">
                                                <i class="fal fa-minus"></i>
                                            </div>
                                            <input id="quantity" type="text" value="1" name="quantity">
                                            <div class="quantity-up" id="quantityUP">
                                                <i class="fal fa-plus"></i>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="unit-price">
                                        <div class="available-info">
                                            <span class="icon fa fa-check thm-bg-clr"></span>Item(s)<br>Avilable Now
                                        </div>
                                    </td>
                                    <td class="price cart_price">$ <span>60.00</span> </td>
                                    <td class="sub-total">$ <span>60</span> </td>
                                    <td>
                                        <div class="remove">
                                            <div class="checkbox">
                                            <span class="fas fa-times item-remove" rel="4"></span>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="2" class="prod-column">
                                        <div class="column-box">
                                            <div class="title pl-0">
                                                <a href="product-details.html"><h3 class="prod-title">Smart Man Jacket</h3></a>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="qty">
                                        <div class="quantity-input">
                                            <div class="quantity-down" id="quantityDown">
                                                <i class="fal fa-minus"></i>
                                            </div>
                                            <input id="quantity" type="text" value="1" name="quantity">
                                            <div class="quantity-up" id="quantityUP">
                                                <i class="fal fa-plus"></i>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="unit-price">
                                        <div class="available-info">
                                            <span class="icon fa fa-check thm-bg-clr"></span>Item(s)<br>Avilable Now
                                        </div>
                                    </td>
                                    <td class="price cart_price">$ <span>60.00</span> </td>
                                    <td class="sub-total">$ <span>60</span> </td>
                                    <td>
                                        <div class="remove">
                                            <div class="checkbox">
                                            <span class="fas fa-times item-remove" rel="4"></span>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="row cart-middle">
                <div class="col-lg-12">
                    <div class="update-cart">
                        <button class="cart-btn"><span>Checkout</span></button>
                        <button class="cart-btn"><span>Update Cart</span></button>
                    </div>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
