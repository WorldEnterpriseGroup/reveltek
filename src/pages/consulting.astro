---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="RevelTek | Consulting"
  description="RevelTek offers expert IT strategy and consulting to guide your digital transformation and technology roadmaps."
  canonicalPath="/consulting.html"
  header="alt"
  footer="consulting"
  heroPreload="/assets/img/breadcrumb.avif">
<!--====== Breadcrumb part Start ======-->
    <section class="breadcrumb-section bg-img-c" style="background-image: url(assets/img/breadcrumb.avif);">
        <div class="container">
            <div class="breadcrumb-text">
                <!-- Updated Title -->
                <h1 class="page-title">Consulting</h1>
                <ul>
                     <!-- Updated Breadcrumb Path -->
                    <li><a href="index.html">Home</a></li> <!-- Removed Home link per rule -->
                    <li>Services</li>
                    <li>Consulting</li>
                </ul>
            </div>
        </div>
        <div class="breadcrumb-shapes">
            <div class="one"></div>
            <div class="two"></div>
            <div class="three"></div>
        </div>
    </section>
    <!--====== Breadcrumb part End ======-->

    <!--====== Service Details Start ======-->
    <section class="service-details section-gap">
        <div class="container">
            <div class="row">
                <!-- Dettails Content -->
                <div class="col-lg-8">
                    <div class="service-details-content">
                        <div class="main-thumb mb-40">
                             <!-- Updated Alt Text -->
                            <img loading="eager" fetchpriority="high" decoding="async" width="770" height="515" src="assets/img/details/service-01.avif" srcset="assets/img/details/service-01.avif 770w" sizes="(max-width: 768px) 100vw, 770px" alt="IT Strategy Meeting">
                        </div>
                        <!-- Updated Title -->
                        <h2 class="title">IT Strategy & Consulting</h2>
                        <!-- Updated Content -->
                        <p>
                           Navigate complex technology decisions with RevelTek. We offer expert IT strategy and consulting services. Our team helps align your tech investments with business goals. We guide digital change and create clear IT roadmaps. Leverage our 20+ years of experience for real results and better efficiency. We aim to turn tech challenges into growth opportunities for you.
                        </p>
                        <ul class="circle-check-list mt-50 mb-50">
                            <!-- Updated List Items -->
                            <li>
                                <i class="fas fa-check"></i>{' '}Gain clear insights from our deep tech knowledge and wide industry background.
                            </li>
                            <li>
                                <i class="fas fa-check"></i>{' '}Develop custom tech roadmaps designed to meet your specific future business vision.
                            </li>
                            <li>
                                <i class="fas fa-check"></i>{' '}Build practical strategies that give you a solid digital edge in your market.
                            </li>
                        </ul>
                        <div class="row align-items-center justify-content-center">
                            <div class="col-lg-6">
                                <div class="image text-center mb-40">
                                     <!-- Updated Alt Text -->
                                    <img loading="lazy" decoding="async" width="370" height="350" src="assets/img/details/service-02.avif" srcset="assets/img/details/service-02.avif 370w" sizes="(max-width: 768px) 100vw, 370px" alt="Consulting Process Visualization">
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <!-- Updated Sub-Title -->
                                <h3 class="sub-title">Our Method</h3>
                                <!-- Updated Content -->
                                <p>
                                    We work directly with your team. Our process involves detailed analysis and planning. We assess your current systems and find key areas for improvement or new tech adoption.
                                </p>
                                <ul class="check-list mt-30 mb-40">
                                    <!-- Updated List Items -->
                                    <li><i class="fas fa-check"></i>Full IT System Audits</li>
                                    <li><i class="fas fa-check"></i>Tech Stack Reviews</li>
                                    <li><i class="fas fa-check"></i>Vendor Choice Help</li>
                                    <li><i class="fas fa-check"></i>Project Implementation Aid</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="faq-section mt-40">
                        <!-- FAQ LOOP - Updated Questions/Answers for Consulting -->
                        <div class="accordion faq-loop border-style" id="faqAccordion">
                            <div class="card">
                                <div class="card-header">
                                    <h6 class="collapsed" data-toggle="collapse" data-target="#collapseOne">
                                        Which areas gain most from your advice?
                                        <span class="icons">
                                            <i class="far fa-plus"></i>
                                        </span>
                                    </h6>
                                </div>
                                <div id="collapseOne" class="collapse" data-parent="#faqAccordion">
                                    <div class="card-body">
                                        We have strong experience in Health, Fintech, and Retail. But our strategic methods work well for any group needing tech updates or digital guidance.
                                    </div>
                                </div>
                            </div>
                            <div class="card">
                                <div class="card-header active-header">
                                    <h6 class="collapsed" data-toggle="collapse" data-target="#collapseTwo">
                                        How do you track success for us?
                                        <span class="icons">
                                            <i class="far fa-minus"></i>
                                        </span>
                                    </h6>
                                </div>
                                <div id="collapseTwo" class="collapse show" data-parent="#faqAccordion">
                                    <div class="card-body">
                                        Success depends on your aims. We set clear goals upfront. We focus on return on investment, efficiency boosts, market growth, or lower risk.
                                    </div>
                                </div>
                            </div>
                            <div class="card">
                                <div class="card-header">
                                    <h6 class="collapsed" data-toggle="collapse" data-target="#collapseThree">
                                        What does a normal project involve?
                                        <span class="icons">
                                            <i class="far fa-plus"></i>
                                        </span>
                                    </h6>
                                </div>
                                <div id="collapseThree" class="collapse" data-parent="#faqAccordion">
                                    <div class="card-body">
                                        Projects differ. Often, they include discovery talks, analysis, strategy building, roadmap plans, and sometimes help with putting plans into action.
                                    </div>
                                </div>
                            </div>
                            <div class="card">
                                <div class="card-header">
                                    <h6 class="collapsed" data-toggle="collapse" data-target="#collapseFour">
                                        How are plans made just for us?
                                        <span class="icons">
                                            <i class="far fa-plus"></i>
                                        </span>
                                    </h6>
                                </div>
                                <div id="collapseFour" class="collapse" data-parent="#faqAccordion">
                                    <div class="card-body">
                                        We avoid generic advice. All tips come from studying your unique business setup, needs, goals, and market position closely for best results.
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- End Faq LOOP -->
                    </div>
                </div>
                <!-- Sidebar -->
                <div class="col-lg-4 col-md-8">
                    <div class="sidebar">
                        <!-- Services List Widget - UPDATED -->
                        <div class="widget cat-widget">
                            <h4 class="widget-title">Our Services</h4>
                            <ul>
                                <!-- Updated Links & Added 'active' class -->
                                <li><a href="software.html">Software <span><i class="far fa-angle-right"></i></span></a></li>
                                <li class="active"><a href="consulting.html">Consulting <span><i class="far fa-angle-right"></i></span></a></li>
                                <li><a href="ai.html">AI <span><i class="far fa-angle-right"></i></span></a></li>
                                <li><a href="products.html">Products <span><i class="far fa-angle-right"></i></span></a></li>
                                <li><a href="cloud.html">Cloud <span><i class="far fa-angle-right"></i></span></a></li>
                                <li><a href="analytics.html">Analytics <span><i class="far fa-angle-right"></i></span></a></li>
                            </ul>
                        </div>
                        <!-- Contact Widget (Kept as is, typo corrected) -->
                        <div class="widget contact-widget">
                            <h4 class="widget-title">Contact Us</h4>
                            <form action="#">
                                <input type="text" placeholder="Your Email">
                                <textarea placeholder="Message"></textarea>
                                <button type="submit" class="main-btn main-btn-3">Send Message</button>
                            </form>
                        </div>
                        <!-- CTA Widget (Kept as is, link updated) -->
                        <div class="widget cta-widget" style="background-image: url(assets/img/sidebar/cta.avif);">
                            <h4 class="title">Need Consultations?</h4> <!-- Simple text -->
                            <a href="contact.html" class="main-btn">Send Message</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--====== Service Details End ======-->

    <!--====== CTA Start ======-->
    <section class="cta-aection">
        <div class="container">
            <div class="cta-wrap bg-img-c" style="background-image: url(assets/img/lines/16.avif);">
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <div class="cta-content text-center">
                            <div class="section-title both-border mb-30">
                                <!-- Updated Title Content -->
                                <span class="title-tag">Get Advice</span>
                                <h2 class="title">Need Help With A Project Or Strategy? Let Us Start Now!</h2>
                            </div>
                             <!-- Updated Button Link -->
                            <a href="contact.html" class="main-btn main-btn-3">Get Started</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--====== CTA End ======-->

    <!--====== Client Area Start ======-->
    <section class="client-section">
        <div class="container">
            <div class="client-slider section-gap line-top">
                <div class="row align-items-center justify-content-between" id="clientSlider">
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="162" height="90" src="assets/img/clients/01.avif" srcset="assets/img/clients/01.avif 162w" sizes="(max-width: 768px) 100vw, 162px" alt="Client Logo 1">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="193" height="85" src="assets/img/clients/02.avif" srcset="assets/img/clients/02.avif 193w" sizes="(max-width: 768px) 100vw, 193px" alt="Client Logo 2">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="117" height="95" src="assets/img/clients/03.avif" srcset="assets/img/clients/03.avif 117w" sizes="(max-width: 768px) 100vw, 117px" alt="Client Logo 3">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="164" height="93" src="assets/img/clients/04.avif" srcset="assets/img/clients/04.avif 164w" sizes="(max-width: 768px) 100vw, 164px" alt="Client Logo 4">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="104" height="96" src="assets/img/clients/05.avif" srcset="assets/img/clients/05.avif 104w" sizes="(max-width: 768px) 100vw, 104px" alt="Client Logo 5">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="162" height="90" src="assets/img/clients/01.avif" srcset="assets/img/clients/01.avif 162w" sizes="(max-width: 768px) 100vw, 162px" alt="Client Logo 6">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="193" height="85" src="assets/img/clients/02.avif" srcset="assets/img/clients/02.avif 193w" sizes="(max-width: 768px) 100vw, 193px" alt="Client Logo 7">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="117" height="95" src="assets/img/clients/03.avif" srcset="assets/img/clients/03.avif 117w" sizes="(max-width: 768px) 100vw, 117px" alt="Client Logo 8">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="164" height="93" src="assets/img/clients/04.avif" srcset="assets/img/clients/04.avif 164w" sizes="(max-width: 768px) 100vw, 164px" alt="Client Logo 9">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="104" height="96" src="assets/img/clients/05.avif" srcset="assets/img/clients/05.avif 104w" sizes="(max-width: 768px) 100vw, 104px" alt="Client Logo 10">
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--====== Client Area End ======-->
</BaseLayout>
