---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="RevelTek | Industries We Serve"
  description="RevelTek provides tailored technology solutions across key industries including Health, Fintech, Retail, and Education."
  canonicalPath="/industries.html"
  ogImage="https://reveltek.com/assets/img/banner/02.avif"
  footer="company"
  heroPreload="/assets/img/banner/01.avif"
>
<!--====== Banner part start ======-->
<section class="banner-section">
	<div class="banner-slider" id="bannerSlider">
		<!-- Slide 1: General Industry Focus -->
		<div class="single-banner" style="background-image: url(assets/img/banner/01.avif);"> <!-- Use a suitable general or collage image -->
			<div class="container">
				<div class="row">
					<div class="col-lg-10">
						<div class="banner-content">
							<!-- Updated Promo Text -->
							<span class="promo-text" data-animation="fadeInDown" data-delay="0.8s">
								Industry Focused Solutions
							</span>
							<!-- Updated Headline -->
							<h1 data-animation="fadeInUp" data-delay="1s">
								Tailored Technology <br> For Your Specific <br> Industry Challenges
							</h1>
							<ul class="btn-wrap">
								<li data-animation="fadeInLeft" data-delay="1.2s">
									<a href="#industries-served" class="main-btn main-btn-4">Explore Industries</a> <!-- Link to section below -->
								</li>
								<li data-animation="fadeInRight" data-delay="1.4s">
									<a href="contact.html" class="main-btn main-btn-2">Request Consultation</a>
								</li>
							</ul>
						</div>
					</div>
				</div>
			</div>
			<div class="banner-shapes"> <div class="one"></div><div class="two"></div><div class="three"></div><div class="four"></div> </div>
		</div>
		<!-- Slide 2: Expertise Focus -->
		<div class="single-banner" style="background-image: url(assets/img/banner/02.avif);"> <!-- Use a suitable general or collage image -->
			<div class="container">
				<div class="row">
					<div class="col-lg-10">
						<div class="banner-content">
							<span class="promo-text" data-animation="fadeInDown" data-delay="0.8s">
								Deep Sector Knowledge
							</span>
							<h2 data-animation="fadeInUp" data-delay="1s">
								Applying Proven <br> Expertise To Solve <br> Your Unique Problems
							</h2>
							<ul class="btn-wrap">
								<li data-animation="fadeInLeft" data-delay="1.2s">
									<a href="why-us.html" class="main-btn main-btn-4">Why Choose RevelTek</a>
								</li>
								<li data-animation="fadeInRight" data-delay="1.4s">
									<a href="studies.html" class="main-btn main-btn-2">See Client Results</a>
								</li>
							</ul>
						</div>
					</div>
				</div>
			</div>
			<div class="banner-shapes"> <div class="one"></div><div class="two"></div><div class="three"></div><div class="four"></div> </div>
		</div>
		<!-- Add more slides if needed -->
	</div>
	<!-- Search wrap removed -->
</section>
<!--====== Banner part end ======-->

<!--====== About Section start ======-->
<section class="about-section about-illustration-img section-gap">
	<div class="container">
		<div class="illustration-img">
			<img loading="eager" fetchpriority="high" decoding="async" width="654" height="556" src="assets/img/illustration/01.avif" srcset="assets/img/illustration/01.avif 654w" sizes="(max-width: 768px) 100vw, 654px" alt="Industry Solutions Illustration"> <!-- Alt text updated -->
		</div>
		<div class="row no-gutters justify-content-lg-end justify-content-center">
			<div class="col-lg-6 col-md-10">
				<div class="about-text">
					<div class="section-title left-border mb-40">
						<span class="title-tag">Our Industry Approach</span> <!-- Updated -->
						<h2 class="title">Understanding Your World <br> To Deliver Better Tech</h2> <!-- Updated -->
					</div>
					<!-- Updated Text -->
					<p class="mb-25">
						At RevelTek, we believe generic solutions fall short. We invest time to understand the specific challenges, regulations, and opportunities within the industries we serve. This focus allows us to build truly effective technology.
					</p>
					<p>
						Our deep sector knowledge ensures our software, AI, cloud, and consulting services are not just technically sound, but also practically relevant and compliant for your environment.
					</p>
					<ul class="about-list">
						<li> <i class="far fa-check"></i>{' '}Industry Specific Expertise</li> <!-- Simplified -->
						<li> <i class="far fa-check"></i>{' '}Compliance & Regulation Aware</li> <!-- Simplified -->
					</ul>
					<a href="about.html" class="main-btn">More About RevelTek</a> <!-- Link to About -->
				</div>
			</div>
		</div>
	</div>
</section>
<!--====== About Section end ======-->

