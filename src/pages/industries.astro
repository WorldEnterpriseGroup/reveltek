						<img loading="lazy" decoding="async" width="103" height="100" src="assets/img/icons/01.avif" srcset="assets/img/icons/01.avif 103w" sizes="(max-width: 768px) 100vw, 103px" alt="Health Icon"> <!-- Use relevant icon -->
					</div>
					<!-- Updated Content & Link -->
					<h3><a href="health.html">Health</a></h3>
					<p>Secure patient data, EHR integration, AI diagnostics</p>
