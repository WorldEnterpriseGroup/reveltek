			<!-- Add more industries if applicable -->
		</div>
	</div>
	<div class="dots-line">
		<img loading="lazy" decoding="async" width="494" height="756" src="assets/img/lines/07.avif" srcset="assets/img/lines/07.avif 494w" sizes="(max-width: 768px) 100vw, 494px" alt="Decorative Dots Line">
