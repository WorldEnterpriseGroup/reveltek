---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="RevelTek | Contact Us"
  description="Contact RevelTek for inquiries about our technology consulting services, partnerships, or support. Get in touch today."
  canonicalPath="/contact.html"
  header="contact"
  footer="company"
>
<!--====== Breadcrumb part Start ======-->
    <section class="breadcrumb-section bg-img-c" style="background-image: url(assets/img/breadcrumb.avif);">
        <div class="container">
            <div class="breadcrumb-text">
                <!-- Updated Title -->
                <h1 class="page-title">Contact Us</h1>
                <ul>
                    <!-- Updated Path -->
                    <li>Contact Us</li>
                </ul>
            </div>
        </div>
        <div class="breadcrumb-shapes">
            <div class="one"></div>
            <div class="two"></div>
            <div class="three"></div>
        </div>
    </section>
    <!--====== Breadcrumb part End ======-->

    <!--====== Contact Section start ======-->
    <section class="contact-section contact-page section-gap-top">
        <div class="container">
            <div class="contact-info">
                <div class="row justify-content-center">
                    <div class="col-lg-6 order-2 order-lg-1">
                        <div class="illustration-img text-center">
                            <!-- Using existing illustration -->
                            <img fetchpriority="high" decoding="async" width="453" height="570" src="assets/img/illustration/man-with-earth-02.avif" alt="Contact Us Illustration">
                        </div>
                    </div>
                    <div class="col-lg-6 col-md-10 order-1 order-lg-2">
                        <div class="contact-info-content">
                            <div class="section-title left-border mb-40">
                                <span class="title-tag">Get In Touch</span>
                                <!-- Updated Title -->
                                <h2 class="title">Need Help? Let's Discuss Your Technology Needs</h2>
                            </div>
                             <!-- Updated Text -->
                            <p>
                                We're ready to help you tackle your biggest technology challenges. Reach out for a consultation, support, or partnership inquiries. Let's build something great together.
                            </p>

                            <ul>
                                <!-- Use Placeholders or Actual Contact Info -->
                                <li class="phone">
                                    <a href="tel:+1800REVELTK"><i class="far fa-phone"></i>+1-800-REVEL-TK</a>
                                </li>
                                <li><i class="far fa-envelope-open"></i><a href="mailto:info@reveltek.com">info@reveltek.com</a></li>
                                <li><i class="far fa-map-marker-alt"></i>Your City, State, USA</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <div class="contact-form grey-bg">
                <div class="row no-gutters justify-content-center">
                    <div class="col-10">
                        <div class="section-title text-center mb-40">
                             <!-- Updated Title -->
                            <h2 class="title">Don’t Hesitate To Contact Us</h2>
                        </div>

                        <form action="#"> <!-- Ensure form action points to a processing script -->
                            <div class="row">
                                <div class="col-lg-4">
                                    <div class="input-group mb-30">
                                        <input type="text" placeholder="Your Full Name" required> <!-- Added required -->
                                        <span class="icon"><i class="far fa-user-circle"></i></span>
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div class="input-group mb-30">
                                        <input type="email" placeholder="Your Email Address" required> <!-- Added required -->
                                        <span class="icon"><i class="far fa-envelope-open"></i></span>
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div class="input-group mb-30">
                                        <input type="text" placeholder="Your Phone (Optional)">
                                        <span class="icon"><i class="far fa-phone"></i></span>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="input-group textarea mb-30">
                                        <textarea placeholder="Write Message" required></textarea> <!-- Added required -->
                                        <span class="icon"><i class="far fa-pencil"></i></span>
                                    </div>
                                </div>
                                <div class="col-12 text-center">
                                    <button type="submit" class="main-btn">Send Message</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div class="container-fluid container-1600">
            <div class="contact-map">
                 <!-- Keep existing map or update src -->
                <iframe
                    src="https://www.google.com/maps/embed?pb=!1m14!1m12!1m3!1d91364.00338430358!2d-73.9756152824982!3d40.698190064837625!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!5e0!3m2!1sen!2sbd!4v1598380219280!5m2!1sen!2sbd"
                    style="border:0;" allowfullscreen="" aria-hidden="false" tabindex="0" title="RevelTek Office Location"></iframe>
            </div>
        </div>
    </section>
    <!--====== Contact Section End ======--> <!-- Corrected comment -->

    <!--====== Client Area Start ======-->
    <section class="client-section">
        <div class="container">
            <div class="client-slider section-gap line-top">
                <div class="row align-items-center justify-content-between" id="clientSlider">
                    <!-- Client logos - keep placeholders -->
                    <div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="162" height="90" src="assets/img/clients/01.avif" alt="Client Logo 1"></a></div>
                    <div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="193" height="85" src="assets/img/clients/02.avif" alt="Client Logo 2"></a></div>
                    <div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="117" height="95" src="assets/img/clients/03.avif" alt="Client Logo 3"></a></div>
                    <div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="164" height="93" src="assets/img/clients/04.avif" alt="Client Logo 4"></a></div>
                    <div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="104" height="96" src="assets/img/clients/05.avif" alt="Client Logo 5"></a></div>
                    <div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="162" height="90" src="assets/img/clients/01.avif" alt="Client Logo 6"></a></div>
                    <div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="193" height="85" src="assets/img/clients/02.avif" alt="Client Logo 7"></a></div>
                    <div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="117" height="95" src="assets/img/clients/03.avif" alt="Client Logo 8"></a></div>
                    <div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="164" height="93" src="assets/img/clients/04.avif" alt="Client Logo 9"></a></div>
                    <div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="104" height="96" src="assets/img/clients/05.avif" alt="Client Logo 10"></a></div>
                </div>
            </div>
        </div>
    </section>
    <!--====== Client Area End ======-->
</BaseLayout>
