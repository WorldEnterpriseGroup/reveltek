								<li data-animation="fadeInLeft" data-delay="1.2s">
									<a href="contact.html" class="main-btn main-btn-4">Build Your Platform</a>
								</li>
								<li data-animation="fadeInRight" data-delay="1.4s">
									<a href="studies.html" class="main-btn main-btn-2">See Success Stories</a>
								</li>
