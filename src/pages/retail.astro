---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="RevelTek | Retail & eCommerce Solutions"
  description="RevelTek delivers technology solutions for the Retail and eCommerce industry, enhancing customer experiences and operations."
  canonicalPath="/retail.html"
  ogImage="https://reveltek.com/assets/img/illustration/02.avif"
  header="overview"
  footer="company"
  heroPreload="/assets/img/banner/01.avif"
>
<!--====== Banner part start ======-->
<section class="banner-section">
	<div class="banner-slider" id="bannerSlider">
		<!-- Slide 1: Retail Focus -->
		<div class="single-banner" style="background-image: url(assets/img/banner/01.avif);"> <!-- Use relevant retail image -->
			<div class="container">
				<div class="row">
					<div class="col-lg-10">
						<div class="banner-content">
							<!-- Updated Promo Text -->
							<span class="promo-text" data-animation="fadeInDown" data-delay="0.8s">
								Retail & eCommerce Solutions
							</span>
							<!-- Updated Headline -->
							<h1 data-animation="fadeInUp" data-delay="1s">
								Enhancing Customer <br> Experiences With <br> Seamless Technology
							</h1>
							<ul class="btn-wrap">
								<li data-animation="fadeInLeft" data-delay="1.2s">
									<a href="contact.html" class="main-btn main-btn-4">Boost Retail Tech</a>
