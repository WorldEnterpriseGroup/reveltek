				</div>
			</div>
			<div class="banner-shapes"> <div class="one"></div><div class="two"></div><div class="three"></div><div class="four"></div> </div>
		</div>
		<!-- Slide 2: Omnichannel Focus -->
		<div class="single-banner" style="background-image: url(assets/img/banner/02.avif);"> <!-- Use relevant retail image -->
			<div class="container">
				<div class="row">
					<div class="col-lg-10">
						<div class="banner-content">
							<span class="promo-text" data-animation="fadeInDown" data-delay="0.8s">
								Omnichannel Excellence
							</span>
