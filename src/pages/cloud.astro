---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="RevelTek | Cloud"
  description="RevelTek provides cloud migration, DevOps implementation, and Infrastructure as Code (IaC) services for businesses."
  canonicalPath="/cloud.html"
  ogImage="https://reveltek.com/assets/img/video-bg/poster-4.avif"
  header="alt"
  footer="services"
  heroPreload="/assets/img/breadcrumb.avif">
<!--====== Breadcrumb part Start ======-->
    <section class="breadcrumb-section bg-img-c" style="background-image: url(assets/img/breadcrumb.avif);">
        <div class="container">
            <div class="breadcrumb-text">
                <!-- Updated Title -->
                <h1 class="page-title">Cloud</h1>
                <ul>
                    <!-- Updated Breadcrumb Path (No Home) -->
                    <li>Services</li>
                    <li>Cloud</li>
                </ul>
            </div>
        </div>
        <div class="breadcrumb-shapes">
            <div class="one"></div>
            <div class="two"></div>
            <div class="three"></div>
        </div>
    </section>
    <!--====== Breadcrumb part End ======-->

    <!--====== Service Section Start ======-->
    <section class="service-section section-gap">
        <div class="container">
            <!-- Section Title -->
            <div class="section-title text-center both-border mb-50">
                 <!-- Updated Title Content -->
                <span class="title-tag">Cloud & Infrastructure</span>
                <h2 class="title">Modernize Your Systems<br> with Cloud Solutions</h2>
            </div>
            <!-- Services Boxes -->
            <div class="row service-boxes justify-content-center">
                <!-- Box 1: Cloud Migration -->
                <div class="col-lg-3 col-sm-6 col-10 wow fadeInUp" data-wow-duration="1500ms" data-wow-delay="400ms">
                    <div class="service-box-three">
                        <div class="icon">
                            <img loading="eager" fetchpriority="high" decoding="async" width="103" height="100" src="assets/img/icons/01.avif" srcset="assets/img/icons/01.avif 103w" sizes="(max-width: 768px) 100vw, 103px" alt="Cloud Migration Icon">
                        </div>
                        <!-- Updated Content -->
                        <h3>Cloud Migration</h3>
                        <p>Move systems safely to cloud</p>
                        <a href="#" class="service-link">
                            <i class="fal fa-long-arrow-right"></i>
                        </a>
                    </div>
                </div>
                <!-- Box 2: DevOps -->
                <div class="col-lg-3 col-sm-6 col-10 wow fadeInUp" data-wow-duration="1500ms" data-wow-delay="500ms">
                    <div class="service-box-three">
                        <div class="icon">
                            <img loading="lazy" decoding="async" width="101" height="101" src="assets/img/icons/02.avif" srcset="assets/img/icons/02.avif 101w" sizes="(max-width: 768px) 100vw, 101px" alt="DevOps Icon">
                        </div>
                         <!-- Updated Content -->
                        <h3>DevOps Practice</h3>
                        <p>Automate delivery pipelines</p>
                        <a href="#" class="service-link">
                            <i class="fal fa-long-arrow-right"></i>
                        </a>
                    </div>
                </div>
                <!-- Box 3: Infrastructure as Code -->
                <div class="col-lg-3 col-sm-6 col-10 wow fadeInUp" data-wow-duration="1500ms" data-wow-delay="600ms">
                    <div class="service-box-three">
                        <div class="icon">
                            <img loading="lazy" decoding="async" width="100" height="100" src="assets/img/icons/03.avif" srcset="assets/img/icons/03.avif 100w" sizes="(max-width: 768px) 100vw, 100px" alt="Code Icon">
                        </div>
                        <!-- Updated Content -->
                        <h3>IaC Solutions</h3>
                        <p>Manage infra with code</p> <!-- IaC = Infrastructure as Code -->
                        <a href="#" class="service-link">
                            <i class="fal fa-long-arrow-right"></i>
                        </a>
                    </div>
                </div>
                <!-- Box 4: Cloud Security -->
                <div class="col-lg-3 col-sm-6 col-10 wow fadeInUp" data-wow-duration="1500ms" data-wow-delay="700ms">
                    <div class="service-box-three">
                        <div class="icon">
                            <img loading="lazy" decoding="async" width="100" height="100" src="assets/img/icons/04.avif" srcset="assets/img/icons/04.avif 100w" sizes="(max-width: 768px) 100vw, 100px" alt="Security Shield Icon">
                        </div>
                        <!-- Updated Content -->
                        <h3>Cloud Security</h3>
                        <p>Protect your cloud assets</p>
                        <a href="#" class="service-link">
                            <i class="fal fa-long-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--====== Service Section End ======-->

    <!--====== Feature Part start ======-->
    <section class="feature-section section-gap grey-bg">
        <div class="container">
            <div class="section-title text-center both-border mb-50">
                 <!-- Updated Title Content -->
                <span class="title-tag"> Cloud Benefits </span>
                <h2 class="title">Gain Agility, Scalability<br> and Resilience</h2>
            </div>
            <!-- Feature boxes -->
            <div class="feature-boxes row justify-content-center">
                <!-- Box 1: AWS Expertise -->
                <div class="col-lg-4 col-md-6 col-10 col-tiny-12">
                    <div class="feature-box">
                        <div class="feature-bg bg-img-c" style="background-image: url(assets/img/feature/01.avif);">
                        </div>
                        <div class="feature-desc">
                            <a href="#" class="feature-link"><i class="fal fa-long-arrow-right"></i></a>
                             <!-- Updated Content -->
                            <h4>AWS Expertise</h4>
                            <p>Leverage Amazon Web Services</p>
                        </div>
                    </div>
                </div>
                 <!-- Box 2: Azure Solutions -->
                <div class="col-lg-4 col-md-6 col-10 col-tiny-12">
                    <div class="feature-box">
                        <div class="feature-bg bg-img-c" style="background-image: url(assets/img/feature/02.avif);">
                        </div>
                        <div class="feature-desc">
                            <a href="#" class="feature-link"><i class="fal fa-long-arrow-right"></i></a>
                             <!-- Updated Content -->
                            <h4>Azure Solutions</h4>
                            <p>Build on Microsoft Azure</p>
                        </div>
                    </div>
                </div>
                <!-- Box 3: GCP Capabilities -->
                <div class="col-lg-4 col-md-6 col-10 col-tiny-12">
                    <div class="feature-box">
                        <div class="feature-bg bg-img-c" style="background-image: url(assets/img/feature/03.avif);">
                        </div>
                        <div class="feature-desc">
                            <a href="#" class="feature-link"><i class="fal fa-long-arrow-right"></i></a>
                             <!-- Updated Content -->
                            <h4>GCP Capabilities</h4>
                            <p>Utilize Google Cloud Platform</p>
                        </div>
                    </div>
                </div>
                 <!-- Box 4: Faster Deployment -->
                <div class="col-lg-4 col-md-6 col-10 col-tiny-12">
                    <div class="feature-box">
                        <div class="feature-bg bg-img-c" style="background-image: url(assets/img/feature/04.avif);">
                        </div>
                        <div class="feature-desc">
                            <a href="#" class="feature-link"><i class="fal fa-long-arrow-right"></i></a>
                             <!-- Updated Content -->
                            <h4>Faster Deployment</h4>
                            <p>Accelerate release cycles</p>
                        </div>
                    </div>
                </div>
                 <!-- Box 5: Cost Optimization -->
                <div class="col-lg-4 col-md-6 col-10 col-tiny-12">
                    <div class="feature-box">
                        <div class="feature-bg bg-img-c" style="background-image: url(assets/img/feature/05.avif);">
                        </div>
                        <div class="feature-desc">
                            <a href="#" class="feature-link"><i class="fal fa-long-arrow-right"></i></a>
                             <!-- Updated Content -->
                            <h4>Cost Efficiency</h4>
                            <p>Optimize cloud spending wisely</p>
                        </div>
                    </div>
                </div>
                 <!-- Box 6: High Availability -->
                <div class="col-lg-4 col-md-6 col-10 col-tiny-12">
                    <div class="feature-box">
                        <div class="feature-bg bg-img-c" style="background-image: url(assets/img/feature/06.avif);">
                        </div>
                        <div class="feature-desc">
                            <a href="#" class="feature-link"><i class="fal fa-long-arrow-right"></i></a>
                             <!-- Updated Content -->
                            <h4>High Availability</h4>
                            <p>Ensure system uptime always</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--====== Feature Part end ======-->

    <!--====== Why Choose Us Section Start ======-->
    <section class="wcu-section section-gap">
        <div class="container">
            <div class="row align-items-center justify-content-center">
                <div class="col-lg-6 col-md-10">
                    <div class="wcu-video wow fadeInUp" data-wow-duration="1500ms" data-wow-delay="400ms">
                        <div class="video-poster-one bg-img-c"
                            style="background-image: url(assets/img/video-bg/poster-4.avif);">
                        </div>
                        <div class="video-poster-two bg-img-c"
                            style="background-image: url(assets/img/video-bg/poster-5.avif);">
                            <a href="https://www.youtube.com/watch?v=fEErySYqItI" class="popup-video" title="Watch Our Cloud Approach">
                                <i class="fas fa-play"></i>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 col-md-10">
                    <div class="wcu-text-two">
                        <div class="section-title left-border mb-40">
                             <!-- Updated Title Content -->
                            <span class="title-tag">Why Choose Our Cloud Team?</span>
                            <h2 class="title">Your Expert Partner for Cloud Transformation</h2>
                        </div>
                        <!-- Updated Paragraph -->
                        <p>
                            We provide strategic cloud advice and hands on implementation. Our certified experts guide you through migration, optimize your environment, and implement DevOps practices. We ensure secure, scalable, and cost effective cloud infrastructure designed for performance.
                        </p>
                         <!-- Updated List - Removed duplicates -->
                        <ul class="wcu-list clearfix">
                            <li>
                                <i class="far fa-check-circle"></i>{' '}Certified Experts
                            </li>
                            <li>
                                <i class="far fa-check-circle"></i>{' '}Proven Methods
                            </li>
                            <li>
                                <i class="far fa-check-circle"></i>{' '}Security Focus
                            </li>
                            <li>
                                <i class="far fa-check-circle"></i>{' '}Cost Management
                            </li>
                            <li>
                                <i class="far fa-check-circle"></i>{' '}Scalable Design
                            </li>
                            <li>
                                <i class="far fa-check-circle"></i>{' '}Smooth Migration
                            </li>
                        </ul>
                         <!-- Updated Button Text/Link -->
                        <a href="contact.html" class="main-btn">Discuss Cloud Needs</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--====== Why Choose Us Section End ======-->

    <!--====== CTA Start ======-->
    <section class="cta-aection">
        <div class="container">
            <div class="cta-wrap bg-img-c" style="background-image: url(assets/img/lines/16.avif);">
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <div class="cta-content text-center">
                            <div class="section-title both-border mb-30">
                                 <!-- Updated Title Content -->
                                <span class="title-tag">Move to Cloud</span>
                                <h2 class="title">Ready to Modernize Your Infrastructure? Contact RevelTek!</h2>
                            </div>
                             <!-- Updated Button Link -->
                            <a href="contact.html" class="main-btn main-btn-3">Get Started</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--====== CTA End ======-->

    <!--====== Client Area Start ======-->
    <section class="client-section">
        <div class="container">
            <div class="client-slider section-gap line-top">
                <div class="row align-items-center justify-content-between" id="clientSlider">
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="162" height="90" src="assets/img/clients/01.avif" srcset="assets/img/clients/01.avif 162w" sizes="(max-width: 768px) 100vw, 162px" alt="Client Logo 1">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="193" height="85" src="assets/img/clients/02.avif" srcset="assets/img/clients/02.avif 193w" sizes="(max-width: 768px) 100vw, 193px" alt="Client Logo 2">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="117" height="95" src="assets/img/clients/03.avif" srcset="assets/img/clients/03.avif 117w" sizes="(max-width: 768px) 100vw, 117px" alt="Client Logo 3">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="164" height="93" src="assets/img/clients/04.avif" srcset="assets/img/clients/04.avif 164w" sizes="(max-width: 768px) 100vw, 164px" alt="Client Logo 4">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="104" height="96" src="assets/img/clients/05.avif" srcset="assets/img/clients/05.avif 104w" sizes="(max-width: 768px) 100vw, 104px" alt="Client Logo 5">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="162" height="90" src="assets/img/clients/01.avif" srcset="assets/img/clients/01.avif 162w" sizes="(max-width: 768px) 100vw, 162px" alt="Client Logo 6">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="193" height="85" src="assets/img/clients/02.avif" srcset="assets/img/clients/02.avif 193w" sizes="(max-width: 768px) 100vw, 193px" alt="Client Logo 7">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="117" height="95" src="assets/img/clients/03.avif" srcset="assets/img/clients/03.avif 117w" sizes="(max-width: 768px) 100vw, 117px" alt="Client Logo 8">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="164" height="93" src="assets/img/clients/04.avif" srcset="assets/img/clients/04.avif 164w" sizes="(max-width: 768px) 100vw, 164px" alt="Client Logo 9">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="104" height="96" src="assets/img/clients/05.avif" srcset="assets/img/clients/05.avif 104w" sizes="(max-width: 768px) 100vw, 104px" alt="Client Logo 10">
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--====== Client Area End ======-->
</BaseLayout>
