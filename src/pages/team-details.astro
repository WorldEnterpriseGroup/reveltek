---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="RevelTek | Team Details"
  description="Representative RevelTek advisor profile — capability-framed by client outcome. Contact us to meet the team for your engagement."
  canonicalPath="/team-details.html"
  ogImage="https://reveltek.com/assets/img/project/02.avif"
  header="inner"
  footer="inner"
  heroPreload="/assets/img/breadcrumb.avif">
<!--====== Breadcrumb part Start ======-->
    <div class="breadcrumb-section bg-img-c" style="background-image: url(assets/img/breadcrumb.avif);">
        <div class="container">
            <div class="breadcrumb-text">
                <h1 class="page-title">Team Details</h1>
                <ul>
                    <li><a href="index.html">Home</a></li>
                    <li>Team Details</li>
                </ul>
            </div>
        </div>
        <div class="breadcrumb-shapes">
            <div class="one"></div>
            <div class="two"></div>
            <div class="three"></div>
        </div>
    </div>
    <!--====== Breadcrumb part End ======-->

    <!--====== Member Details Start ======-->
    <section class="member-details-wrapper section-gap-top">
        <div class="container">
            <div class="member-details">
                <div class="member-picture-wrap">
                    <div class="member-picture">
                        <img loading="eager" fetchpriority="high" decoding="async" width="270" height="320" src="assets/img/team/01.avif" srcset="assets/img/team/01.avif 270w" sizes="(max-width: 768px) 100vw, 270px" alt="RevelTek advisor profile photo">
                    </div>
                </div>
                <div class="member-desc">
                    <h3 class="name">John N. Holmes</h3>
                    <span class="pro">Advises fintech clients on platform strategy</span>
                    <p>
                        Representative profile. Works from current-state assessment through roadmap,
                        build, and operating handover — matching the delivery plan to measurable
                        outcomes: cost, delivery speed, and operational risk.
                    </p>
                    <p>
                        The advisor team for your engagement is matched to the outcome, not whoever
                        happens to be free. <a href="contact.html">Contact us</a> to discuss the right
                        mix for your scope.
                    </p>
                </div>
                <div class="member-contact-info">
                    <h3 class="title">Get In Touch</h3>
                    <span class="title-tag">Contact Us</span>
                    <ul class="contact-info">
                        <li><a href="contact.html"><i class="far fa-envelope"></i>{' '}Contact us via the contact page</a></li>
                        <li><i class="far fa-check-circle"></i>{' '}Direct answer on fit, scope, and cost</li>
                        <li><i class="far fa-clock"></i>{' '}Response within one business day</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>
    <!--====== Member Details End ======-->

    <!--====== Skill Section Start ======-->
    <section class="skill-section skill-section-two">
        <div class="container">
            <div class="row align-items-center justify-content-center">
                <div class="col-lg-6 col-md-10">
                    <!-- Skill Text Block -->
                    <div class="skill-text">
                        <div class="section-title mb-40 left-border">
                            <span class="title-tag">Capabilities</span>
                            <h2 class="title">Matched To <br> Your Outcome</h2>
                        </div>
                        <p>
                            Advisors cover platform strategy, cloud migration, AI and analytics, and
                            commerce delivery. Each engagement gets assess-to-operate coverage: a
                            current-state assessment, a prioritized roadmap, implementation support, and
                            an operating handover with runbooks.
                        </p>

                    </div>
                </div>
                <div class="col-lg-6 col-md-10">
                    <div class="skill-progress-bars">
                        <div class="skill-progress">
                            <div class="title d-flex justify-content-between">
                                <span>Marketing Strategy</span>
                                <span>85%</span>
                            </div>
                            <div class="progressbar-wrap">
                                <div class="progressbar" data-width="85">
                                </div>
                            </div>
                        </div>
                        <div class="skill-progress">
                            <div class="title d-flex justify-content-between">
                                <span>Digital Marketing</span>
                                <span>95%</span>
                            </div>
                            <div class="progressbar-wrap">
                                <div class="progressbar" data-width="95">
                                </div>
                            </div>
                        </div>
                        <div class="skill-progress">
                            <div class="title d-flex justify-content-between">
                                <span>Web Design</span>
                                <span>72%</span>
                            </div>
                            <div class="progressbar-wrap">
                                <div class="progressbar" data-width="72">
                                </div>
                            </div>
                        </div>
                        <div class="skill-progress">
                            <div class="title d-flex justify-content-between">
                                <span>IT Consulting</span>
                                <span>79%</span>
                            </div>
                            <div class="progressbar-wrap">
                                <div class="progressbar" data-width="79">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--====== Skill Section End ======-->

    <!-- Line -->
    <div class="container">
        <div class="line-bottom"></div>
    </div>

    <!--====== Project section Start ======-->
    <section class="project-section">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-7 col-md-8">
                    <!-- Section Title -->
                    <div class="section-title left-border">
                        <span class="title-tag">Recent Engagements</span>
                        <h2 class="title">Representative Work, Measurable Outcomes</h2>
                    </div>
                </div>
                <div class="col-lg-5 col-md-4">
                    <div class="view-moore-btn text-md-right mt-30 mt-md-0">
                        <a href="portfolio.html" class="main-btn">View More Work</a>
                    </div>
                </div>
            </div>

            <!-- Project Boxes -->
            <div class="row project-boxes mt-80 justify-content-center">
                <div class="col-lg-4 col-sm-6">
                    <div class="project-box">
                        <div class="project-thumb">
                            <div class="thumb bg-img-c" style="background-image: url(assets/img/project/01.avif);"></div>
                        </div>
                        <div class="project-desc text-center">
                            <h4><a href="portfolio-details.html">Discovery Assessment</a></h4>
                            <p>Assess systems, spend, and bottlenecks</p>
                            <a href="portfolio-details.html" class="project-link">
                                <i class="fal fa-long-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-sm-6">
                    <div class="project-box">
                        <div class="project-thumb">
                            <div class="thumb bg-img-c" style="background-image: url(assets/img/project/02.avif);"></div>
                        </div>
                        <div class="project-desc text-center">
                            <h4><a href="portfolio-details.html">Roadmap And Build</a></h4>
                            <p>Sequenced delivery with owners and dates</p>
                            <a href="portfolio-details.html" class="project-link">
                                <i class="fal fa-long-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-sm-6">
                    <div class="project-box">
                        <div class="project-thumb">
                            <div class="thumb bg-img-c" style="background-image: url(assets/img/project/03.avif);"></div>
                        </div>
                        <div class="project-desc text-center">
                            <h4><a href="portfolio-details.html">Operate And Handover</a></h4>
                            <p>Runbooks and support so results hold</p>
                            <a href="portfolio-details.html" class="project-link">
                                <i class="fal fa-long-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--====== Project section End ======-->

    <!--====== Client Area Start ======-->
    <section class="client-section">
        <div class="container">
            <div class="client-slider section-gap line-top">
                <div class="row align-items-center justify-content-between" id="clientSlider">
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="162" height="90" src="assets/img/clients/01.avif" srcset="assets/img/clients/01.avif 162w" sizes="(max-width: 768px) 100vw, 162px" alt="Client logo 1">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="193" height="85" src="assets/img/clients/02.avif" srcset="assets/img/clients/02.avif 193w" sizes="(max-width: 768px) 100vw, 193px" alt="Client logo 2">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="117" height="95" src="assets/img/clients/03.avif" srcset="assets/img/clients/03.avif 117w" sizes="(max-width: 768px) 100vw, 117px" alt="Client logo 3">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="164" height="93" src="assets/img/clients/04.avif" srcset="assets/img/clients/04.avif 164w" sizes="(max-width: 768px) 100vw, 164px" alt="Client logo 4">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="104" height="96" src="assets/img/clients/05.avif" srcset="assets/img/clients/05.avif 104w" sizes="(max-width: 768px) 100vw, 104px" alt="Client logo 5">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="162" height="90" src="assets/img/clients/01.avif" srcset="assets/img/clients/01.avif 162w" sizes="(max-width: 768px) 100vw, 162px" alt="Client logo 1">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="193" height="85" src="assets/img/clients/02.avif" srcset="assets/img/clients/02.avif 193w" sizes="(max-width: 768px) 100vw, 193px" alt="Client logo 2">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="117" height="95" src="assets/img/clients/03.avif" srcset="assets/img/clients/03.avif 117w" sizes="(max-width: 768px) 100vw, 117px" alt="Client logo 3">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="164" height="93" src="assets/img/clients/04.avif" srcset="assets/img/clients/04.avif 164w" sizes="(max-width: 768px) 100vw, 164px" alt="Client logo 4">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="104" height="96" src="assets/img/clients/05.avif" srcset="assets/img/clients/05.avif 104w" sizes="(max-width: 768px) 100vw, 104px" alt="Client logo 5">
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--====== Client Area End ======-->
</BaseLayout>
