---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="RevelTek | Services Details"
  description="How RevelTek delivers. Assess, roadmap, build, operate. Clear deliverables and direct teamwork."
  canonicalPath="/service-details.html"
  ogImage="https://reveltek.com/assets/img/details/service-01.avif"
  header="inner"
  footer="inner"
  heroPreload="/assets/img/breadcrumb.avif">
<!--====== Breadcrumb part Start ======-->
    <section class="breadcrumb-section bg-img-c" style="background-image: url(assets/img/breadcrumb.avif);">
        <div class="container">
            <div class="breadcrumb-text">
                <h1 class="page-title">Services Details</h1>
                <ul>
                    <li><a href="index.html">Home</a></li>
                    <li>Services Details</li>
                </ul>
            </div>
        </div>
        <div class="breadcrumb-shapes">
            <div class="one"></div>
            <div class="two"></div>
            <div class="three"></div>
        </div>
    </section>
    <!--====== Breadcrumb part End ======-->

    <!--====== Service Details Start ======-->
    <section class="service-details section-gap">
        <div class="container">
            <div class="row">
                <!-- Dettails Content -->
                <div class="col-lg-8">
                    <div class="service-details-content">
                        <div class="main-thumb mb-40">
                            <img loading="eager" fetchpriority="high" decoding="async" width="770" height="515" src="assets/img/details/service-01.avif" srcset="assets/img/details/service-01.avif 770w" sizes="(max-width: 768px) 100vw, 770px" alt="RevelTek engagement model illustration">
                        </div>
                        <h2 class="title">Our Engagement Model</h2>
                        <p>
                            RevelTek Inc. is a US-based consulting firm with 20+ years of experience. We plan,
                            build, and run technology for business results. You work directly with senior people.
                            You see progress in small, tested releases.
                        </p>
                        <ul class="circle-check-list mt-50 mb-50">
                            <li>
                                <i class="fas fa-check"></i>{' '}A written roadmap with priorities, timelines, and costs.
                            </li>
                            <li>
                                <i class="fas fa-check"></i>{' '}Working software in small releases you can test.
                            </li>
                            <li>
                                <i class="fas fa-check"></i>{' '}Docs, training, and handover so your team can run it.
                            </li>
                        </ul>
                        <div class="row align-items-center justify-content-center">
                            <div class="col-lg-6">
                                <div class="image text-center mb-40">
                                    <img loading="lazy" decoding="async" width="370" height="350" src="assets/img/details/service-02.avif" srcset="assets/img/details/service-02.avif 370w" sizes="(max-width: 768px) 100vw, 370px" alt="RevelTek delivery process illustration">
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <h3 class="sub-title">Assess, Roadmap, Build, Operate</h3>
                                <p>
                                    Every engagement follows four steps. You approve each one before we start
                                    the next.
                                </p>
                                <ul class="check-list mt-30 mb-40">
                                    <li><i class="fas fa-check"></i>Assess. We review your systems, goals, and gaps.</li>
                                    <li><i class="fas fa-check"></i>Roadmap. You get priorities, timelines, and costs.</li>
                                    <li><i class="fas fa-check"></i>Build. We design, build, and test with your team.</li>
                                    <li><i class="fas fa-check"></i>Operate. We launch, monitor, and support the result.</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="faq-section mt-40">
                        <!-- FAQ LOOP -->
                        <div class="accordion faq-loop border-style" id="faqAccordion">
                            <div class="card">
                                <div class="card-header">
                                    <h6 class="collapsed" data-toggle="collapse" data-target="#collapseOne">
                                        How does an engagement start?

                                        <span class="icons">
                                            <i class="far fa-plus"></i>
                                        </span>
                                    </h6>
                                </div>

                                <div id="collapseOne" class="collapse" data-parent="#faqAccordion">
                                    <div class="card-body">
                                        With a short discovery call. We review your goals and systems. Then we send scope, timeline, and cost. Use the contact form to start.
                                    </div>
                                </div>
                            </div>
                            <div class="card">
                                <div class="card-header active-header">
                                    <h6 class="collapsed" data-toggle="collapse" data-target="#collapseTwo">
                                        What do we receive at each stage?

                                        <span class="icons">
                                            <i class="far fa-minus"></i>
                                        </span>
                                    </h6>
                                </div>

                                <div id="collapseTwo" class="collapse show" data-parent="#faqAccordion">
                                    <div class="card-body">
                                        Assess ends with findings. Roadmap ends with a plan and budget. Build ends with tested releases. Operate ends with docs and support.
                                    </div>
                                </div>
                            </div>
                            <div class="card">
                                <div class="card-header">
                                    <h6 class="collapsed" data-toggle="collapse" data-target="#collapseThree">
                                        How long does delivery take?

                                        <span class="icons">
                                            <i class="far fa-plus"></i>
                                        </span>
                                    </h6>
                                </div>

                                <div id="collapseThree" class="collapse" data-parent="#faqAccordion">
                                    <div class="card-body">
                                        It depends on scope. Small pilots run in weeks. Larger builds run in phases. Your roadmap states dates upfront.
                                    </div>
                                </div>
                            </div>
                            <div class="card">
                                <div class="card-header">
                                    <h6 class="collapsed" data-toggle="collapse" data-target="#collapseFour">
                                        Do you work with our in-house team?

                                        <span class="icons">
                                            <i class="far fa-plus"></i>
                                        </span>
                                    </h6>
                                </div>
                                <div id="collapseFour" class="collapse" data-parent="#faqAccordion">
                                    <div class="card-body">
                                        Yes. We plan and build beside your staff. We hand over docs and training before we leave.
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- End Faq LOOP -->
                    </div>
                </div>
                <!-- Sidebar -->
                <div class="col-lg-4 col-md-8">
                    <div class="sidebar">
                        <!-- Services List Widget -->
                        <div class="widget cat-widget">
                            <h4 class="widget-title">Our Services</h4>

                            <ul>
                                <li><a href="software.html">Software <span><i class="far fa-angle-right"></i></span></a></li>
                                <li><a href="consulting.html">Consulting <span><i class="far fa-angle-right"></i></span></a></li>
                                <li><a href="ai.html">AI <span><i class="far fa-angle-right"></i></span></a></li>
                                <li><a href="products.html">Products <span><i class="far fa-angle-right"></i></span></a></li>
                                <li><a href="cloud.html">Cloud <span><i class="far fa-angle-right"></i></span></a></li>
                                <li><a href="analytics.html">Analytics <span><i class="far fa-angle-right"></i></span></a></li>
                            </ul>
                        </div>
                        <!-- Contact Widget -->
                        <div class="widget contact-widget">
                            <h4 class="widget-title">Contact Us</h4>
                            <form action="#">
                                <input type="text" placeholder="Your Email">
                                <textarea placeholder="Message"></textarea>
                                <button type="submit" class="main-btn main-btn-3">Send Message</button>
                            </form>
                        </div>
                        <!-- CTA Widget -->
                        <div class="widget cta-widget" style="background-image: url(assets/img/sidebar/cta.avif);">
                            <h4 class="title">Need Consultations?</h4>
                            <a href="contact.html" class="main-btn">Send Message</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--====== Service Details End ======-->

    <!--====== CTA Start ======-->
    <section class="cta-aection">
        <div class="container">
            <div class="cta-wrap bg-img-c" style="background-image: url(assets/img/lines/16.avif);">
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <div class="cta-content text-center">
                            <div class="section-title both-border mb-30">
                                <span class="title-tag">Get Advice</span>
                                <h2 class="title">Need Help With A Project Or Strategy? Let Us Start Now!</h2>
                            </div>
                            <a href="contact.html" class="main-btn main-btn-3">Get Started</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--====== CTA Start ======-->

    <!--====== Client Area Start ======-->
    <section class="client-section">
        <div class="container">
            <div class="client-slider section-gap line-top">
                <div class="row align-items-center justify-content-between" id="clientSlider">
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="162" height="90" src="assets/img/clients/01.avif" srcset="assets/img/clients/01.avif 162w" sizes="(max-width: 768px) 100vw, 162px" alt="Client logo 1">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="193" height="85" src="assets/img/clients/02.avif" srcset="assets/img/clients/02.avif 193w" sizes="(max-width: 768px) 100vw, 193px" alt="Client logo 2">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="117" height="95" src="assets/img/clients/03.avif" srcset="assets/img/clients/03.avif 117w" sizes="(max-width: 768px) 100vw, 117px" alt="Client logo 3">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="164" height="93" src="assets/img/clients/04.avif" srcset="assets/img/clients/04.avif 164w" sizes="(max-width: 768px) 100vw, 164px" alt="Client logo 4">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="104" height="96" src="assets/img/clients/05.avif" srcset="assets/img/clients/05.avif 104w" sizes="(max-width: 768px) 100vw, 104px" alt="Client logo 5">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="162" height="90" src="assets/img/clients/01.avif" srcset="assets/img/clients/01.avif 162w" sizes="(max-width: 768px) 100vw, 162px" alt="Client logo 1">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="193" height="85" src="assets/img/clients/02.avif" srcset="assets/img/clients/02.avif 193w" sizes="(max-width: 768px) 100vw, 193px" alt="Client logo 2">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="117" height="95" src="assets/img/clients/03.avif" srcset="assets/img/clients/03.avif 117w" sizes="(max-width: 768px) 100vw, 117px" alt="Client logo 3">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="164" height="93" src="assets/img/clients/04.avif" srcset="assets/img/clients/04.avif 164w" sizes="(max-width: 768px) 100vw, 164px" alt="Client logo 4">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="104" height="96" src="assets/img/clients/05.avif" srcset="assets/img/clients/05.avif 104w" sizes="(max-width: 768px) 100vw, 104px" alt="Client logo 5">
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--====== Client Area End ======-->
</BaseLayout>
