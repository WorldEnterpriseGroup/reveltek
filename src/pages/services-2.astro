---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="RevelTek | Services Two"
  description="RevelTek services. Software and SaaS, IT strategy consulting, AI, cloud, and analytics. Practical delivery with clear outcomes."
  canonicalPath="/services-2.html"
  ogImage="https://reveltek.com/assets/img/feature/02.avif"
  header="inner"
  footer="inner"
  heroPreload="/assets/img/breadcrumb.avif">
<!--====== Breadcrumb part Start ======-->
    <section class="breadcrumb-section bg-img-c" style="background-image: url(assets/img/breadcrumb.avif);">
        <div class="container">
            <div class="breadcrumb-text">
                <h1 class="page-title">Our Services</h1>
                <ul>
                    <li><a href="index.html">Home</a></li>
                    <li>Services</li>
                </ul>
            </div>
        </div>
        <div class="breadcrumb-shapes">
            <div class="one"></div>
            <div class="two"></div>
            <div class="three"></div>
        </div>
    </section>
    <!--====== Breadcrumb part End ======-->

    <!--====== Service Section Start ======-->
    <section class="service-section section-gap">
        <div class="container">
            <!-- Section Title -->
            <div class="section-title text-center both-border mb-50">
                <span class="title-tag">What We Do</span>
                <h2 class="title">Services That Move <br> Your Business Forward</h2>
            </div>
            <!-- Services Boxes -->
            <div class="row service-boxes justify-content-center">
                <div class="col-lg-3 col-sm-6 col-10 wow fadeInUp" data-wow-duration="1500ms" data-wow-delay="400ms">
                    <div class="service-box-three">
                        <div class="icon">
                            <img loading="eager" fetchpriority="high" decoding="async" width="103" height="100" src="assets/img/icons/01.avif" srcset="assets/img/icons/01.avif 103w" sizes="(max-width: 768px) 100vw, 103px" alt="Software and SaaS icon">
                        </div>
                        <h3>Software And SaaS</h3>
                        <p>We build and ship software your team can run. Each release adds working value.</p>
                        <a href="service-details.html" class="service-link">
                            <i class="fal fa-long-arrow-right"></i>
                        </a>
                    </div>
                </div>
                <div class="col-lg-3 col-sm-6 col-10 wow fadeInUp" data-wow-duration="1500ms" data-wow-delay="500ms">
                    <div class="service-box-three">
                        <div class="icon">
                            <img loading="lazy" decoding="async" width="101" height="101" src="assets/img/icons/02.avif" srcset="assets/img/icons/02.avif 101w" sizes="(max-width: 768px) 100vw, 101px" alt="IT Strategy Consulting icon">
                        </div>
                        <h3>IT Strategy Consulting</h3>
                        <p>We turn business goals into a funded tech plan. You know what comes first.</p>
                        <a href="service-details.html" class="service-link">
                            <i class="fal fa-long-arrow-right"></i>
                        </a>
                    </div>
                </div>
                <div class="col-lg-3 col-sm-6 col-10 wow fadeInUp" data-wow-duration="1500ms" data-wow-delay="600ms">
                    <div class="service-box-three">
                        <div class="icon">
                            <img loading="lazy" decoding="async" width="100" height="100" src="assets/img/icons/03.avif" srcset="assets/img/icons/03.avif 100w" sizes="(max-width: 768px) 100vw, 100px" alt="AI Solutions icon">
                        </div>
                        <h3>AI Solutions</h3>
                        <p>We pilot AI where it pays. You see working results before wider rollout.</p>
                        <a href="service-details.html" class="service-link">
                            <i class="fal fa-long-arrow-right"></i>
                        </a>
                    </div>
                </div>
                <div class="col-lg-3 col-sm-6 col-10 wow fadeInUp" data-wow-duration="1500ms" data-wow-delay="700ms">
                    <div class="service-box-three">
                        <div class="icon">
                            <img loading="lazy" decoding="async" width="100" height="100" src="assets/img/icons/04.avif" srcset="assets/img/icons/04.avif 100w" sizes="(max-width: 768px) 100vw, 100px" alt="Cloud and Analytics icon">
                        </div>
                        <h3>Cloud And Analytics</h3>
                        <p>We migrate systems and clean data. Your costs drop and reports agree.</p>
                        <a href="service-details.html" class="service-link">
                            <i class="fal fa-long-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--====== Service Section End ======-->

    <!--====== Feature Part start ======-->
    <section class="feature-section section-gap grey-bg">
        <div class="container">
            <div class="section-title text-center both-border mb-50">
                <span class="title-tag"> What We Do </span>
                <h2 class="title">Services That Grow <br> Your Business</h2>
            </div>
            <!-- Feature boxes -->
            <div class="feature-boxes row justify-content-center">
                <div class="col-lg-4 col-md-6 col-10 col-tiny-12">
                    <div class="feature-box">
                        <div class="feature-bg bg-img-c" style="background-image: url(assets/img/feature/01.avif);">
                        </div>
                        <div class="feature-desc">
                            <a href="service-details.html" class="feature-link"><i class="fal fa-long-arrow-right"></i></a>
                            <h4>Custom Software</h4>
                            <p>Tools shaped to your process, delivered in tested releases.</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 col-10 col-tiny-12">
                    <div class="feature-box">
                        <div class="feature-bg bg-img-c" style="background-image: url(assets/img/feature/02.avif);">
                        </div>
                        <div class="feature-desc">
                            <a href="service-details.html" class="feature-link"><i class="fal fa-long-arrow-right"></i></a>
                            <h4>Data And Analytics</h4>
                            <p>One set of numbers your leaders trust.</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 col-10 col-tiny-12">
                    <div class="feature-box">
                        <div class="feature-bg bg-img-c" style="background-image: url(assets/img/feature/03.avif);">
                        </div>
                        <div class="feature-desc">
                            <a href="service-details.html" class="feature-link"><i class="fal fa-long-arrow-right"></i></a>
                            <h4>IT Consulting</h4>
                            <p>Roadmaps and reviews that tie tech spend to goals.</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 col-10 col-tiny-12">
                    <div class="feature-box">
                        <div class="feature-bg bg-img-c" style="background-image: url(assets/img/feature/04.avif);">
                        </div>
                        <div class="feature-desc">
                            <a href="service-details.html" class="feature-link"><i class="fal fa-long-arrow-right"></i></a>
                            <h4>AI Pilots</h4>
                            <p>Small trials on your data that prove value fast.</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 col-10 col-tiny-12">
                    <div class="feature-box">
                        <div class="feature-bg bg-img-c" style="background-image: url(assets/img/feature/05.avif);">
                        </div>
                        <div class="feature-desc">
                            <a href="service-details.html" class="feature-link"><i class="fal fa-long-arrow-right"></i></a>
                            <h4>Cloud Migration</h4>
                            <p>Moves planned around uptime, cost, and risk.</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 col-10 col-tiny-12">
                    <div class="feature-box">
                        <div class="feature-bg bg-img-c" style="background-image: url(assets/img/feature/06.avif);">
                        </div>
                        <div class="feature-desc">
                            <a href="service-details.html" class="feature-link"><i class="fal fa-long-arrow-right"></i></a>
                            <h4>Managed Support</h4>
                            <p>Monitoring and help after launch, from the team that built it.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--====== Feature Part end ======-->

    <!--====== Why Choose Us Section Start ======-->
    <section class="wcu-section section-gap">
        <div class="container">
            <div class="row align-items-center justify-content-center">
                <div class="col-lg-6 col-md-10">
                    <div class="wcu-video wow fadeInUp" data-wow-duration="1500ms" data-wow-delay="400ms">
                        <div class="video-poster-one bg-img-c"
                            style="background-image: url(assets/img/video-bg/poster-4.avif);">
                        </div>
                        <div class="video-poster-two bg-img-c"
                            style="background-image: url(assets/img/video-bg/poster-5.avif);">
                            <a href="https://www.youtube.com/watch?v=fEErySYqItI" class="popup-video">
                                <i class="fas fa-play"></i>
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 col-md-10">
                    <div class="wcu-text-two">
                        <div class="section-title left-border mb-40">
                            <span class="title-tag">Why RevelTek</span>
                            <h2 class="title">Practical Help, From Start To Finish</h2>
                        </div>
                        <p>
                            We keep teams small and senior. You talk to the people doing the work. Plans stay
                            short. Releases stay frequent.
                        </p>
                        <ul class="wcu-list clearfix">
                            <li>
                                <i class="far fa-check-circle"></i>{' '}US-Based Team
                            </li>
                            <li>
                                <i class="far fa-check-circle"></i>{' '}20+ Years Of Experience
                            </li>
                            <li>
                                <i class="far fa-check-circle"></i>{' '}Outcome-Led Delivery
                            </li>
                            <li>
                                <i class="far fa-check-circle"></i>{' '}Clear Roadmaps
                            </li>
                            <li>
                                <i class="far fa-check-circle"></i>{' '}Direct Communication
                            </li>
                            <li>
                                <i class="far fa-check-circle"></i>{' '}Business-First Advice
                            </li>
                            <li>
                                <i class="far fa-check-circle"></i>{' '}Full Lifecycle Support
                            </li>
                            <li>
                                <i class="far fa-check-circle"></i>{' '}Practical Methods
                            </li>
                            <li>
                                <i class="far fa-check-circle"></i>{' '}Honest Pricing
                            </li>
                            <li>
                                <i class="far fa-check-circle"></i>{' '}Ongoing Support
                            </li>
                        </ul>
                        <a href="contact.html" class="main-btn">Work With Us</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--====== Why Choose Us Section End ======-->

    <!--====== CTA Start ======-->
    <section class="cta-aection">
        <div class="container">
            <div class="cta-wrap bg-img-c" style="background-image: url(assets/img/lines/16.avif);">
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <div class="cta-content text-center">
                            <div class="section-title both-border mb-30">
                                <span class="title-tag">Get Advice</span>
                                <h2 class="title">Need Help With A Project Or Strategy? Let Us Start Now!</h2>
                            </div>
                            <a href="contact.html" class="main-btn main-btn-3">Get Started</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--====== CTA Start ======-->

    <!--====== Client Area Start ======-->
    <section class="client-section">
        <div class="container">
            <div class="client-slider section-gap line-top">
                <div class="row align-items-center justify-content-between" id="clientSlider">
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="162" height="90" src="assets/img/clients/01.avif" srcset="assets/img/clients/01.avif 162w" sizes="(max-width: 768px) 100vw, 162px" alt="Client logo 1">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="193" height="85" src="assets/img/clients/02.avif" srcset="assets/img/clients/02.avif 193w" sizes="(max-width: 768px) 100vw, 193px" alt="Client logo 2">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="117" height="95" src="assets/img/clients/03.avif" srcset="assets/img/clients/03.avif 117w" sizes="(max-width: 768px) 100vw, 117px" alt="Client logo 3">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="164" height="93" src="assets/img/clients/04.avif" srcset="assets/img/clients/04.avif 164w" sizes="(max-width: 768px) 100vw, 164px" alt="Client logo 4">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="104" height="96" src="assets/img/clients/05.avif" srcset="assets/img/clients/05.avif 104w" sizes="(max-width: 768px) 100vw, 104px" alt="Client logo 5">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="162" height="90" src="assets/img/clients/01.avif" srcset="assets/img/clients/01.avif 162w" sizes="(max-width: 768px) 100vw, 162px" alt="Client logo 1">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="193" height="85" src="assets/img/clients/02.avif" srcset="assets/img/clients/02.avif 193w" sizes="(max-width: 768px) 100vw, 193px" alt="Client logo 2">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="117" height="95" src="assets/img/clients/03.avif" srcset="assets/img/clients/03.avif 117w" sizes="(max-width: 768px) 100vw, 117px" alt="Client logo 3">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="164" height="93" src="assets/img/clients/04.avif" srcset="assets/img/clients/04.avif 164w" sizes="(max-width: 768px) 100vw, 164px" alt="Client logo 4">
                        </a>
                    </div>
                    <div class="col">
                        <a href="#" class="client-img d-block text-center">
                            <img loading="lazy" decoding="async" width="104" height="96" src="assets/img/clients/05.avif" srcset="assets/img/clients/05.avif 104w" sizes="(max-width: 768px) 100vw, 104px" alt="Client logo 5">
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--====== Client Area End ======-->
</BaseLayout>
