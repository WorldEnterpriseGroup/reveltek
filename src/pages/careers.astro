---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="RevelTek | Careers"
  description="Explore career opportunities at RevelTek. Join our innovative team in SaaS, AI, Cloud, Consulting, and more. Find your next role."
  canonicalPath="/careers.html"
  footer="company"
  heroPreload="/assets/img/breadcrumb.avif">
<!--====== Breadcrumb part Start ======-->
    <section class="breadcrumb-section bg-img-c" style="background-image: url(assets/img/breadcrumb.avif);">
        <div class="container">
            <div class="breadcrumb-text">
                 <!-- Updated Title -->
                <h1 class="page-title">Careers at RevelTek</h1>
                <ul>
                    <!-- Updated Path -->
                    <li>About</li>
                    <li>Careers</li>
                </ul>
            </div>
        </div>
        <div class="breadcrumb-shapes">
            <div class="one"></div>
            <div class="two"></div>
            <div class="three"></div>
        </div>
    </section>
    <!--====== Breadcrumb part End ======-->

    <!--====== Job Category Start======-->
    <section class="job-category-section section-gap">
        <div class="container">
            <!-- Updated Categories -->
            <div class="job-categories">
                <div class="single-cat wow fadeInUp" data-wow-duration="1500ms" data-wow-delay="400ms">
                    <a href="#job-list"> <!-- Link to job list section below -->
                        <i class="flaticon-computer"></i> <!-- Keep icon or update -->
                        <span>Software Eng</span> <!-- Updated -->
                    </a>
                </div>
                <div class="single-cat wow fadeInUp" data-wow-duration="1500ms" data-wow-delay="500ms">
                    <a href="#job-list">
                        <i class="flaticon-creative"></i>
                        <span>Consulting</span> <!-- Updated -->
                    </a>
                </div>
                <div class="single-cat wow fadeInUp" data-wow-duration="1500ms" data-wow-delay="600ms">
                    <a href="#job-list">
                        <i class="flaticon-artificial-intelligence"></i> <!-- Updated Icon -->
                        <span>AI / ML</span> <!-- Updated -->
                    </a>
                </div>
                <div class="single-cat wow fadeInUp" data-wow-duration="1500ms" data-wow-delay="700ms">
                    <a href="#job-list">
                        <i class="flaticon-cloud-computing-1"></i> <!-- Updated Icon -->
                        <span>Cloud & DevOps</span> <!-- Updated -->
                    </a>
                </div>
                <div class="single-cat wow fadeInUp" data-wow-duration="1500ms" data-wow-delay="800ms">
                    <a href="#job-list">
                        <i class="flaticon-idea"></i>
                        <span>Product Mgmt</span> <!-- Updated -->
                    </a>
                </div>
                <div class="single-cat wow fadeInUp" data-wow-duration="1500ms" data-wow-delay="900ms">
                    <a href="#job-list">
                        <i class="flaticon-analysis"></i>
                        <span>Data Analytics</span> <!-- Updated -->
                    </a>
                </div>
                <div class="single-cat wow fadeInUp" data-wow-duration="1500ms" data-wow-delay="1s">
                    <a href="#job-list">
                        <i class="flaticon-target-1"></i> <!-- Keep icon or update -->
                        <span>Sales & Marketing</span> <!-- Updated -->
                    </a>
                </div>
                <div class="single-cat wow fadeInUp" data-wow-duration="1500ms" data-wow-delay="1.1s">
                    <a href="#job-list">
                        <i class="flaticon-support"></i> <!-- Updated Icon -->
                        <span>Operations</span> <!-- Updated -->
                    </a>
                </div>
            </div>
        </div>
    </section>
    <!--====== Job Category End======-->

    <!--====== Job List Start======-->
    <section id="job-list" class="job-list-section section-gap grey-bg"> <!-- Added ID -->
        <div class="container">
            <!-- Updated Section Title -->
             <div class="section-title text-center both-border mb-50">
                <span class="title-tag">Join Our Team</span>
                <h2 class="title">Current Open Positions Available</h2>
            </div>
            <!-- Updated Job Listings -->
            <div class="job-lists">
                <!-- Job 1 Example -->
                <div class="single-job">
                    <h4 class="title">Senior Software Engineer <span class="job-time">(Full Time)</span></h4>
                    <p>
                       Design, develop, and maintain high quality SaaS applications using modern tech stacks. Requires strong backend experience and cloud knowledge. Collaborate within agile teams.
                    </p>
                    <!-- Link to a specific job detail page -->
                    <a href="job-details.html?id=swe-01" class="apply-btn">apply now <i class="far fa-long-arrow-right"></i></a>
                </div>
                 <!-- Job 2 Example -->
                <div class="single-job">
                    <h4 class="title">AI/ML Engineer <span class="job-time">(Full Time)</span></h4>
                    <p>
                       Build and deploy machine learning models for client solutions. Work on predictive analytics, NLP, or computer vision projects. Experience with Python and ML frameworks needed here.
                    </p>
                    <a href="job-details.html?id=ai-01" class="apply-btn">apply now <i class="far fa-long-arrow-right"></i></a>
                </div>
                 <!-- Job 3 Example -->
                <div class="single-job">
                    <h4 class="title">IT Strategy Consultant <span class="job-time">(Full Time)</span></h4>
                    <p>
                       Advise clients on digital transformation, technology roadmaps, and enterprise architecture. Strong communication and problem solving skills are essential for success. Travel may be required.
                    </p>
                    <a href="job-details.html?id=con-01" class="apply-btn">apply now <i class="far fa-long-arrow-right"></i></a>
                </div>
                 <!-- Job 4 Example -->
                <div class="single-job">
                    <h4 class="title">Cloud DevOps Engineer <span class="job-time">(Full Time)</span></h4>
                    <p>
                       Implement and manage CI/CD pipelines, infrastructure as code (IaC), and cloud monitoring solutions. Expertise in AWS or Azure required. Help automate our client deployments fully.
                    </p>
                    <a href="job-details.html?id=cloud-01" class="apply-btn">apply now <i class="far fa-long-arrow-right"></i></a>
                </div>
                 <!-- Job 5 Example -->
                <div class="single-job">
                    <h4 class="title">UX/UI Designer <span class="job-time">(Contract)</span></h4> <!-- Example Contract -->
                    <p>
                       Create intuitive and engaging user interfaces for web and mobile applications. Develop wireframes, prototypes, and high fidelity designs. Strong portfolio showcasing user centric design work.
                    </p>
                    <a href="job-details.html?id=ux-01" class="apply-btn">apply now <i class="far fa-long-arrow-right"></i></a>
                </div>
                 <!-- Job 6 Example -->
                <div class="single-job">
                    <h4 class="title">Technical Product Manager <span class="job-time">(Full Time)</span></h4>
                    <p>
                       Define product vision, strategy, and requirements for SaaS solutions. Work closely with engineering and design teams using agile methods to deliver valuable products for clients.
                    </p>
                    <a href="job-details.html?id=pm-01" class="apply-btn">apply now <i class="far fa-long-arrow-right"></i></a>
                </div>
            </div>
            <div class="view-btn text-center mt-60">
                 <!-- Link to a page listing ALL jobs -->
                <a href="jobs.html" class="main-btn">View All Open Roles</a>
            </div>
        </div>
    </section>
    <!--====== Job List End======-->

    <!--====== Client Area Start ======-->
    <section class="client-section">
        <div class="container">
            <div class="client-slider section-gap"> <!-- Removed line-top -->
                <div class="row align-items-center justify-content-between" id="clientSlider">
                    <!-- Client logos - keep placeholders -->
                    <div class="col"><a href="#" class="client-img d-block text-center"><img loading="eager" fetchpriority="high" decoding="async" width="162" height="90" src="assets/img/clients/01.avif" srcset="assets/img/clients/01.avif 162w" sizes="(max-width: 768px) 100vw, 162px" alt="Client Logo 1"></a></div>
                    <div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="193" height="85" src="assets/img/clients/02.avif" srcset="assets/img/clients/02.avif 193w" sizes="(max-width: 768px) 100vw, 193px" alt="Client Logo 2"></a></div>
                    <div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="117" height="95" src="assets/img/clients/03.avif" srcset="assets/img/clients/03.avif 117w" sizes="(max-width: 768px) 100vw, 117px" alt="Client Logo 3"></a></div>
                    <div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="164" height="93" src="assets/img/clients/04.avif" srcset="assets/img/clients/04.avif 164w" sizes="(max-width: 768px) 100vw, 164px" alt="Client Logo 4"></a></div>
                    <div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="104" height="96" src="assets/img/clients/05.avif" srcset="assets/img/clients/05.avif 104w" sizes="(max-width: 768px) 100vw, 104px" alt="Client Logo 5"></a></div>
                    <div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="162" height="90" src="assets/img/clients/01.avif" srcset="assets/img/clients/01.avif 162w" sizes="(max-width: 768px) 100vw, 162px" alt="Client Logo 6"></a></div>
                    <div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="193" height="85" src="assets/img/clients/02.avif" srcset="assets/img/clients/02.avif 193w" sizes="(max-width: 768px) 100vw, 193px" alt="Client Logo 7"></a></div>
                    <div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="117" height="95" src="assets/img/clients/03.avif" srcset="assets/img/clients/03.avif 117w" sizes="(max-width: 768px) 100vw, 117px" alt="Client Logo 8"></a></div>
                    <div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="164" height="93" src="assets/img/clients/04.avif" srcset="assets/img/clients/04.avif 164w" sizes="(max-width: 768px) 100vw, 164px" alt="Client Logo 9"></a></div>
                    <div class="col"><a href="#" class="client-img d-block text-center"><img loading="lazy" decoding="async" width="104" height="96" src="assets/img/clients/05.avif" srcset="assets/img/clients/05.avif 104w" sizes="(max-width: 768px) 100vw, 104px" alt="Client Logo 10"></a></div>
                </div>
            </div>
        </div>
    </section>
    <!--====== Client Area End ======-->
</BaseLayout>
